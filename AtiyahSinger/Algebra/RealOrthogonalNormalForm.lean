module

public import Mathlib.Analysis.InnerProductSpace.Spectrum
public import Mathlib.LinearAlgebra.Dimension.OrzechProperty

/-!
# Real orthogonal spectral blocks

Public module ID: M0047.

An orthogonal operator on a finite-dimensional real inner product space has
an invariant line or an invariant oriented plane. The real symmetric spectral
theorem applied to `U + U⁻¹` supplies the two-dimensional cyclic subspace.
In dimension two its determinant is computed in the cyclic basis before
choosing orthonormal coordinates. Induction on the orthogonal complement
then gives the full real normal form, with line coordinates followed by
ordered plane coordinates.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

universe u

/-- A nonzero finite-dimensional real orthogonal operator has an invariant line or
an invariant plane on which its determinant is one. The restricted operator is
the original operator on the same subspace. -/
theorem exists_invariant_line_or_plane
    {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [Nontrivial E] (U : E ≃ₗᵢ[ℝ] E) :
    ∃ (W : Submodule ℝ E) (V : W ≃ₗᵢ[ℝ] W),
      (Module.finrank ℝ W = 1 ∨ Module.finrank ℝ W = 2) ∧
      (∀ x : W, (V x : E) = U x) ∧
      (Module.finrank ℝ W = 2 → LinearMap.det V.toLinearMap = 1) := by
  classical
  -- A real eigenvector of the symmetric part generates a cyclic subspace
  -- stable under both U and its inverse.
  let S : E →ₗ[ℝ] E := U.toLinearMap + U.symm.toLinearMap
  have hS : S.IsSymmetric := by
    intro x y
    change inner ℝ (U x + U.symm x) y = inner ℝ x (U y + U.symm y)
    rw [inner_add_left, inner_add_right, U.inner_map_eq_flip,
      U.symm.inner_map_eq_flip]
    simp only [LinearIsometryEquiv.symm_symm]
    exact add_comm _ _
  let i : Fin (Module.finrank ℝ E) := ⟨0, Module.finrank_pos⟩
  let v : E := hS.eigenvectorBasis rfl i
  let c : ℝ := hS.eigenvalues rfl i
  have hv : v ≠ 0 := (hS.eigenvectorBasis rfl).toBasis.ne_zero i
  have heig : U v + U.symm v = c • v := hS.apply_eigenvectorBasis rfl i
  have hinv : U.symm v = c • v - U v := by
    rw [← heig]
    abel
  have hsq : U (U v) = c • U v - v := by
    have h := congrArg U heig
    simp only [map_add, map_smul, U.apply_symm_apply] at h
    rw [← h]
    abel
  let w : Fin 2 → E := ![v, U v]
  let W : Submodule ℝ E := Submodule.span ℝ (Set.range w)
  have hW : W = Submodule.span ℝ ({v, U v} : Set E) := by
    simp [W, w, Matrix.range_cons, Matrix.range_empty, Set.pair_comm]
  have hvW : v ∈ W := Submodule.subset_span ⟨0, rfl⟩
  have hUvW : U v ∈ W := Submodule.subset_span ⟨1, rfl⟩
  have hforward : ∀ x ∈ W, U x ∈ W := by
    intro x hx
    obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp (hW ▸ hx)
    simpa only [map_add, map_smul, hsq] using
      W.add_mem (W.smul_mem a hUvW)
        (W.smul_mem b (W.sub_mem (W.smul_mem c hUvW) hvW))
  have hbackward : ∀ x ∈ W, U.symm x ∈ W := by
    intro x hx
    obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp (hW ▸ hx)
    simpa only [map_add, map_smul, hinv, U.symm_apply_apply] using
      W.add_mem (W.smul_mem a (W.sub_mem (W.smul_mem c hvW) hUvW))
        (W.smul_mem b hvW)
  let V : W ≃ₗᵢ[ℝ] W :=
    { toLinearEquiv :=
        { toFun := fun x ↦ ⟨U x, hforward x x.property⟩
          invFun := fun x ↦ ⟨U.symm x, hbackward x x.property⟩
          left_inv := fun x ↦ Subtype.ext (U.symm_apply_apply x)
          right_inv := fun x ↦ Subtype.ext (U.apply_symm_apply x)
          map_add' := fun x y ↦ Subtype.ext (map_add U (x : E) (y : E))
          map_smul' := fun a x ↦ Subtype.ext (map_smul U a (x : E)) }
      norm_map' := fun x ↦ U.norm_map x }
  -- The cyclic subspace is nonzero and generated by two vectors.
  have hdimpos : 0 < Module.finrank ℝ W :=
    Module.finrank_pos_iff_exists_ne_zero.mpr
      ⟨⟨v, hvW⟩, fun h ↦ hv (congrArg Subtype.val h)⟩
  have hdimle : Module.finrank ℝ W ≤ 2 := by
    simpa [W, Set.finrank] using (finrank_range_le_card (R := ℝ) w)
  refine ⟨W, V, by omega, fun _ ↦ rfl, ?_⟩
  intro hdim
  -- If the cyclic subspace has dimension two, (v, Uv) is a basis.
  -- Its matrix is [[0,-1],[1,c]], whose determinant is exactly one.
  have hw : LinearIndependent ℝ w :=
    linearIndependent_iff_card_eq_finrank_span.mpr (by simpa [W, Set.finrank] using hdim.symm)
  let B : Module.Basis (Fin 2) ℝ W := Module.Basis.span hw
  have hB (j : Fin 2) : (B j : E) = w j := by
    exact Module.Basis.coe_span_apply hw j
  have hVzero : V (B 0) = B 1 := by
    apply Subtype.ext
    change U (B 0 : E) = (B 1 : E)
    simp [hB, w]
  have hVone : V (B 1) = -B 0 + c • B 1 := by
    apply Subtype.ext
    change U (B 1 : E) = -(B 0 : E) + c • (B 1 : E)
    simp only [hB, w, Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [hsq]
    abel
  have hmatrix : LinearMap.toMatrix B B V.toLinearMap = !![0, -1; 1, c] := by
    ext j k
    fin_cases j <;> fin_cases k <;>
      simp [LinearMap.toMatrix_apply, hVzero, hVone]
  rw [← LinearMap.det_toMatrix B, hmatrix, Matrix.det_fin_two]
  norm_num

private theorem exists_orthonormalBasis_sum
    {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] (W : Submodule ℝ E)
    {ι κ : Type} [Fintype ι] [Fintype κ]
    (B : OrthonormalBasis ι ℝ W) (C : OrthonormalBasis κ ℝ Wᗮ) :
    ∃ D : OrthonormalBasis (ι ⊕ κ) ℝ E,
      (∀ i, D (.inl i) = (B i : E)) ∧
      (∀ j, D (.inr j) = (C j : E)) := by
  classical
  let b : Module.Basis (ι ⊕ κ) ℝ E :=
    (B.toBasis.prod C.toBasis).map (W.prodEquivOfIsCompl Wᗮ W.isCompl_orthogonal)
  have hb (i : ι) : b (.inl i) = (B i : E) := by
    simp [b, Submodule.coe_prodEquivOfIsCompl']
  have hc (j : κ) : b (.inr j) = (C j : E) := by
    simp [b, Submodule.coe_prodEquivOfIsCompl']
  have hbc (i : ι) (j : κ) : inner ℝ (B i : E) (C j : E) = 0 :=
    (C j).property _ (B i).property
  have hon : Orthonormal ℝ b := by
    apply orthonormal_iff_ite.mpr
    intro i j
    cases i with
    | inl i =>
      cases j with
      | inl j =>
        simpa only [hb, Sum.inl.injEq, Submodule.coe_inner] using B.inner_eq_ite i j
      | inr j => simp [hb, hc, hbc]
    | inr i =>
      cases j with
      | inl j =>
        simp only [hb, hc, reduceCtorEq, ite_false]
        rw [real_inner_comm]
        exact hbc j i
      | inr j =>
        simpa only [hc, Sum.inr.injEq, Submodule.coe_inner] using C.inner_eq_ite i j
  refine ⟨b.toOrthonormalBasis hon, ?_, ?_⟩
  · intro i
    simpa using hb i
  · intro j
    simpa using hc j

/-- A real orthogonal operator admits an orthonormal basis of invariant lines
and oriented planes, with all lines preceding the ordered plane pairs. -/
theorem exists_orthonormalBasis_orthogonal_blocks
    {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] (U : E ≃ₗᵢ[ℝ] E) :
    ∃ (a b : ℕ) (B : OrthonormalBasis (Fin a ⊕ (Fin b × Fin 2)) ℝ E)
      (l : Fin a → Matrix.orthogonalGroup (Fin 1) ℝ)
      (p : Fin b → Matrix.specialOrthogonalGroup (Fin 2) ℝ),
      (∀ i, U (B (.inl i)) = (l i).val 0 0 • B (.inl i)) ∧
      (∀ j s, U (B (.inr (j, s))) =
        ∑ t : Fin 2, (p j).val t s • B (.inr (j, t))) := by
  classical
  generalize hn : Module.finrank ℝ E = n
  induction n using Nat.strong_induction_on generalizing E with
  | h n ih =>
    by_cases hn0 : n = 0
    · -- The zero space has the empty line-and-plane basis.
      let : Subsingleton E := Module.finrank_zero_iff.mp (hn.trans hn0)
      let v : (Fin 0 ⊕ (Fin 0 × Fin 2)) → E := fun i ↦ isEmptyElim i
      let B : OrthonormalBasis (Fin 0 ⊕ (Fin 0 × Fin 2)) ℝ E :=
        OrthonormalBasis.mk (v := v) (orthonormal_iff_ite.mpr (fun i ↦ isEmptyElim i))
          (by intro x _; simpa only [Subsingleton.elim x 0] using
            (Submodule.zero_mem (Submodule.span ℝ (Set.range v))))
      exact ⟨0, 0, B, fun i ↦ isEmptyElim i, fun i ↦ isEmptyElim i,
        fun i ↦ isEmptyElim i, fun i ↦ isEmptyElim i⟩
    · let : Nontrivial E := Module.finrank_pos_iff.mp (hn ▸ Nat.pos_of_ne_zero hn0)
      obtain ⟨W, V, hdim, hV, hdet⟩ := exists_invariant_line_or_plane U
      -- Orthogonality makes the same complement stable in both directions.
      have hforward (x : E) (hx : x ∈ W) : U x ∈ W := by
        rw [← hV ⟨x, hx⟩]
        exact (V ⟨x, hx⟩).property
      have hbackward (x : E) (hx : x ∈ W) : U.symm x ∈ W := by
        have hv := congrArg U.symm (hV (V.symm ⟨x, hx⟩))
        simp only [V.apply_symm_apply, U.symm_apply_apply] at hv
        rw [hv]
        exact (V.symm ⟨x, hx⟩).property
      have hperp (x : E) (hx : x ∈ Wᗮ) : U x ∈ Wᗮ := by
        intro y hy
        calc
          inner ℝ y (U x) = inner ℝ (U.symm y) x := by
            simpa only [LinearIsometryEquiv.symm_symm] using
              (U.symm.inner_map_eq_flip y x).symm
          _ = 0 := hx _ (hbackward y hy)
      have hperpinv (x : E) (hx : x ∈ Wᗮ) : U.symm x ∈ Wᗮ := by
        intro y hy
        rw [← U.inner_map_eq_flip y x]
        exact hx _ (hforward y hy)
      let Vp : Wᗮ ≃ₗᵢ[ℝ] Wᗮ :=
        { toLinearEquiv :=
            { toFun := fun x ↦ ⟨U x, hperp x x.property⟩
              invFun := fun x ↦ ⟨U.symm x, hperpinv x x.property⟩
              left_inv := fun x ↦ Subtype.ext (U.symm_apply_apply x)
              right_inv := fun x ↦ Subtype.ext (U.apply_symm_apply x)
              map_add' := fun x y ↦ Subtype.ext (map_add U (x : E) (y : E))
              map_smul' := fun a x ↦ Subtype.ext (map_smul U a (x : E)) }
          norm_map' := fun x ↦ U.norm_map x }
      have hlt : Module.finrank ℝ Wᗮ < n := by
        have hsum := W.finrank_add_finrank_orthogonal
        omega
      obtain ⟨a, b, B, l, p, hl, hp⟩ := ih (Module.finrank ℝ Wᗮ) hlt Vp rfl
      have hl' (i : Fin a) : U (B (.inl i) : E) =
          (l i).val 0 0 • (B (.inl i) : E) :=
        congrArg Subtype.val (hl i)
      have hp' (j : Fin b) (s : Fin 2) : U (B (.inr (j, s)) : E) =
          ∑ t : Fin 2, (p j).val t s • (B (.inr (j, t)) : E) := by
        have h := congrArg Subtype.val (hp j s)
        change U (B (.inr (j, s)) : E) =
          ((∑ t : Fin 2, (p j).val t s • B (.inr (j, t))) : Wᗮ) at h
        simpa only [Submodule.coe_sum, Submodule.coe_smul] using h
      rcases hdim with hdim | hdim
      · -- Add the invariant line at the start of the existing line family.
        let C : OrthonormalBasis (Fin 1) ℝ W :=
          (stdOrthonormalBasis ℝ W).reindex (finCongr hdim)
        let m : Matrix.orthogonalGroup (Fin 1) ℝ :=
          ⟨V.toLinearEquiv.toMatrix C.toBasis C.toBasis,
            V.toMatrix_mem_unitaryGroup C C⟩
        have hm : U (C 0 : E) = m.val 0 0 • (C 0 : E) := by
          have hc := C.sum_repr (V (C 0))
          simp only [Fin.sum_univ_one] at hc
          rw [← hV]
          simpa [m, LinearMap.toMatrix_apply] using
            congrArg Subtype.val hc.symm
        obtain ⟨D, hDleft, hDright⟩ := exists_orthonormalBasis_sum W C B
        let e : (Fin 1 ⊕ (Fin a ⊕ (Fin b × Fin 2))) ≃
            (Fin (1 + a) ⊕ (Fin b × Fin 2)) :=
          (Equiv.sumAssoc _ _ _).symm.trans
            (finSumFinEquiv.sumCongr (Equiv.refl _))
        let B' := D.reindex e
        let l' : Fin (1 + a) → Matrix.orthogonalGroup (Fin 1) ℝ :=
          fun i ↦ Sum.elim (fun _ ↦ m) l (finSumFinEquiv.symm i)
        refine ⟨1 + a, b, B', l', p, ?_, ?_⟩
        · intro i
          obtain ⟨i, rfl⟩ := finSumFinEquiv.surjective i
          cases i with
          | inl i =>
            have hi : i = 0 := Subsingleton.elim _ _
            subst i
            simpa [B', e, l', OrthonormalBasis.reindex_apply, hDleft] using hm
          | inr i =>
            simpa [B', e, l', OrthonormalBasis.reindex_apply, hDright] using hl' i
        · intro j s
          simpa [B', e, OrthonormalBasis.reindex_apply, hDright] using hp' j s
      · -- Add the invariant plane before the old planes, keeping all lines first.
        let C : OrthonormalBasis (Fin 2) ℝ W :=
          (stdOrthonormalBasis ℝ W).reindex (finCongr hdim)
        let m : Matrix.specialOrthogonalGroup (Fin 2) ℝ :=
          ⟨V.toLinearEquiv.toMatrix C.toBasis C.toBasis,
            V.toMatrix_mem_unitaryGroup C C, by
              change Matrix.det (LinearMap.toMatrix C.toBasis C.toBasis V.toLinearMap) = 1
              rw [LinearMap.det_toMatrix, hdet hdim]⟩
        have hm (s : Fin 2) : U (C s : E) =
            ∑ t : Fin 2, m.val t s • (C t : E) := by
          rw [← hV]
          simpa [m, LinearMap.toMatrix_apply] using
            congrArg Subtype.val (C.sum_repr (V (C s))).symm
        obtain ⟨D, hDleft, hDright⟩ := exists_orthonormalBasis_sum W C B
        let e : (Fin 2 ⊕ (Fin a ⊕ (Fin b × Fin 2))) ≃
            (Fin a ⊕ (Fin (1 + b) × Fin 2)) :=
          { toFun := fun i ↦ match i with
              | .inl s => .inr (finSumFinEquiv (.inl 0), s)
              | .inr (.inl j) => .inl j
              | .inr (.inr (j, s)) => .inr (finSumFinEquiv (.inr j), s)
            invFun := fun i ↦ match i with
              | .inl j => .inr (.inl j)
              | .inr (j, s) => match finSumFinEquiv.symm j with
                | .inl _ => .inl s
                | .inr k => .inr (.inr (k, s))
            left_inv := by
              intro i
              rcases i with s | (j | ⟨j, s⟩) <;> simp
            right_inv := by
              intro i
              rcases i with j | ⟨j, s⟩
              · rfl
              · obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
                cases j with
                | inl j =>
                  have hj : j = 0 := Subsingleton.elim _ _
                  subst j
                  simp
                | inr j => simp }
        let B' := D.reindex e
        let p' : Fin (1 + b) → Matrix.specialOrthogonalGroup (Fin 2) ℝ :=
          fun j ↦ Sum.elim (fun _ ↦ m) p (finSumFinEquiv.symm j)
        refine ⟨a, 1 + b, B', l, p', ?_, ?_⟩
        · intro i
          simpa [B', e, OrthonormalBasis.reindex_apply, hDright] using hl' i
        · intro j s
          obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
          cases j with
          | inl j =>
            have hj : j = 0 := Subsingleton.elim _ _
            subst j
            simpa [B', e, p', OrthonormalBasis.reindex_apply, hDleft] using hm s
          | inr j =>
            simpa [B', e, p', OrthonormalBasis.reindex_apply, hDright] using hp' j s

end AtiyahSinger
