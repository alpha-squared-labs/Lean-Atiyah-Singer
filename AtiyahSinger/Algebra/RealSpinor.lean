module

public import AtiyahSinger.Algebra.ComplexSpinor
public import AtiyahSinger.Algebra.ExteriorParity
public import Mathlib.LinearAlgebra.CliffordAlgebra.SpinGroup
public import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic
public import Mathlib.LinearAlgebra.QuadraticForm.Basic

import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith

/-!
# The real Clifford algebra and its complex spin representation

Public module ID: M0048.

The underlying real space of complex Euclidean m-space has dimension 2m. Its
quadratic form is the negative squared norm, as required by Spin Geometry.
Restriction of the specified complex generators along the same real/imaginary
embedding gives an actual real Clifford algebra representation on ComplexSpinor m.
Its generators act by the original wedge-minus-Hermitian-contraction symbol.

The group acting here is exactly mathlib's spinGroup for this real quadratic form.
Its elements map to units of the real Clifford algebra, then to units of the
complex endomorphism algebra, and finally to complex linear automorphisms. Even
Clifford elements preserve both exterior parity subspaces, so the same group
action restricts to each of them. The chirality comparison in SpinorChirality
identifies these subspaces with the two normalized-volume eigenspaces. The same
spin element acts on real vectors by native Clifford conjugation, transported
through the original vector embedding. This action preserves the negative
quadratic form, and Clifford multiplication intertwines the two specified actions.

Sources: Lawson--Michelsohn, Spin Geometry, I.2 and I.5 Definition 5.14,
Proposition 5.15 and equations (5.25)--(5.27), printed pp. 36--38 for I.5.
The conjugation compatibility is also Gilkey, Invariance Theory, Lemma 3.2.3,
printed pp. 160--162. This module gives the algebraic even-dimensional complex
representation. It does not assert a topology, a
double-cover identification with SO(2m), or half-spin irreducibility. The zero
dimensional model is retained without a positive-rank hypothesis. The native
Lipschitz membership condition, generated by invertible vector images, is retained
along with evenness and the unitary condition. No alternate zero-dimensional
group or comparison with another convention for Spin(0) is asserted.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

/-- The negative Euclidean form on the underlying real space of complex m-space. -/
def realSpinorQuadraticForm (m : ℕ) : QuadraticForm ℝ (EuclideanSpace ℂ (Fin m)) := by
  letI := InnerProductSpace.complexToReal (G := EuclideanSpace ℂ (Fin m))
  exact -LinearMap.BilinMap.toQuadraticMap (innerₗ (EuclideanSpace ℂ (Fin m)))

/-- Restrict the same complex Clifford generators along the prescribed real embedding. -/
def realSpinorGenerator (m : ℕ) :
    EuclideanSpace ℂ (Fin m) →ₗ[ℝ] Module.End ℂ (ComplexSpinor m) :=
  ((complexSpinorGenerator m).restrictScalars ℝ).comp (complexSpinorRealEmbedding m)

/-- The specified real generators satisfy the negative-norm Clifford relation. -/
theorem realSpinorGenerator_sq (m : ℕ) (v : EuclideanSpace ℂ (Fin m)) :
    realSpinorGenerator m v * realSpinorGenerator m v =
      algebraMap ℝ (Module.End ℂ (ComplexSpinor m)) (realSpinorQuadraticForm m v) := by
  /- Stage 1: apply complexSpinorGenerator_sq to the prescribed real/imaginary
  embedding of v. The compatibility theorem complexSpinorQuadraticForm_real
  identifies its complex quadratic value with -||v||^2.
  Stage 2: the real form is the negative real inner product on the diagonal,
  hence has exactly that real value. The scalar tower from R through C to the
  complex endomorphism algebra identifies the two scalar endomorphisms. This
  checks the actual real Clifford relation without treating Hermitian
  contraction as complex-linear in the contracted vector. -/
  -- The real generator is the same complex generator along its original embedding.
  change complexSpinorGenerator m (complexSpinorRealEmbedding m v) *
      complexSpinorGenerator m (complexSpinorRealEmbedding m v) = _
  rw [complexSpinorGenerator_sq, complexSpinorQuadraticForm_real]
  have hq : realSpinorQuadraticForm m v = -‖v‖ ^ 2 := by
    let := InnerProductSpace.complexToReal (G := EuclideanSpace ℂ (Fin m))
    change -(inner ℝ v v) = -‖v‖ ^ 2
    rw [real_inner_self_eq_norm_sq]
  rw [hq]
  apply LinearMap.ext
  intro s
  change -(‖v‖ ^ 2 : ℂ) • s = (-‖v‖ ^ 2 : ℝ) • s
  have hcast : (algebraMap ℝ ℂ) (-‖v‖ ^ 2) = -(‖v‖ ^ 2 : ℂ) := by
    simp
  rw [← hcast]
  exact IsScalarTower.algebraMap_smul ℂ (-‖v‖ ^ 2 : ℝ) s

/-- The real negative-norm Clifford algebra acts on the same complex spinor carrier. -/
def realSpinorRepresentation (m : ℕ) :
    CliffordAlgebra (realSpinorQuadraticForm m) →ₐ[ℝ]
      Module.End ℂ (ComplexSpinor m) :=
  CliffordAlgebra.lift (realSpinorQuadraticForm m)
    ⟨realSpinorGenerator m, realSpinorGenerator_sq m⟩

/-- Real Clifford multiplication is exactly the original Bott symbol on every generator. -/
theorem realSpinorRepresentation_ι (m : ℕ) (v : EuclideanSpace ℂ (Fin m)) :
    realSpinorRepresentation m (CliffordAlgebra.ι (realSpinorQuadraticForm m) v) =
      cliffordSymbol v := by
  /- Stage 1: the real universal lift evaluates on its generating vector as
  realSpinorGenerator m v. Its definition is the original complex generator
  evaluated on the fixed real/imaginary embedding.
  Stage 2: evaluate the complex universal lift at the same embedded vector and
  apply complexSpinorRepresentation_real. This returns the existing symbol,
  with its negative-contraction sign and its original exterior algebra. -/
  -- Both universal lifts evaluate on the identical embedded generating vector.
  rw [realSpinorRepresentation, CliffordAlgebra.lift_ι_apply]
  have h := complexSpinorRepresentation_real m v
  rw [complexSpinorRepresentation, CliffordAlgebra.lift_ι_apply] at h
  exact h

/-- Clifford degree adds to the exterior parity under the actual real representation. -/
theorem realSpinorRepresentation_mem_evenOdd (m : ℕ) (i j : ZMod 2)
    (a : CliffordAlgebra (realSpinorQuadraticForm m))
    (ha : a ∈ CliffordAlgebra.evenOdd (realSpinorQuadraticForm m) i)
    (s : ComplexSpinor m)
    (hs : s ∈ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ
      (EuclideanSpace ℂ (Fin m))) j) :
    realSpinorRepresentation m a s ∈
      CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) (i + j) := by
  /- Stage 1: a single real Clifford generator acts as cliffordSymbol, which
  changes exterior parity by one. A product of k such generators therefore
  changes parity by k modulo two; a scalar preserves parity.
  Stage 2: the native Clifford evenOdd submodule is spanned by products of the
  indicated parity. Extend the preceding assertion through finite sums and
  real scalar multiples, using the real algebra homomorphism and the complex
  submodule closure of the target exterior parity. The same argument includes
  degree zero and the zero-dimensional carrier. -/
  -- Induct in the native Clifford grading, retaining the same spinor vector and target parity.
  induction a, ha using CliffordAlgebra.evenOdd_induction with
  | range_ι_pow x hx =>
    fin_cases i
    · change x ∈ (CliffordAlgebra.ι (realSpinorQuadraticForm m)).range ^ (0 : ℕ) at hx
      rw [pow_zero] at hx
      obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hx
      rw [AlgHom.commutes]
      change (r : ℂ) • s ∈ CliffordAlgebra.evenOdd _ (0 + j)
      simpa only [zero_add] using (CliffordAlgebra.evenOdd _ j).smul_mem (r : ℂ) hs
    · change x ∈ (CliffordAlgebra.ι (realSpinorQuadraticForm m)).range ^ (1 : ℕ) at hx
      rw [pow_one] at hx
      obtain ⟨v, rfl⟩ := hx
      rw [realSpinorRepresentation_ι]
      change cliffordSymbol v s ∈ CliffordAlgebra.evenOdd _ (1 + j)
      simpa only [add_comm] using cliffordSymbol_mem_evenOdd v j s hs
  | add x y hx hy ihx ihy =>
    simpa only [map_add, LinearMap.add_apply] using
      (CliffordAlgebra.evenOdd _ _).add_mem ihx ihy
  | ι_mul_ι_mul v w x hx ih =>
    -- Each original vector changes parity; two successive changes restore it.
    rw [map_mul, map_mul, realSpinorRepresentation_ι, realSpinorRepresentation_ι]
    have hfirst := cliffordSymbol_mem_evenOdd w (i + j) (realSpinorRepresentation m x s) ih
    have hsecond := cliffordSymbol_mem_evenOdd v (i + j + 1)
      (cliffordSymbol w (realSpinorRepresentation m x s)) hfirst
    simpa only [Module.End.mul_apply, add_assoc,
      show (1 : ZMod 2) + 1 = 0 from rfl, add_zero] using hsecond

/-- SG I.5.14: restriction to the actual real spin group gives complex automorphisms. -/
def complexSpinRepresentation (m : ℕ) :
    spinGroup (realSpinorQuadraticForm m) →* (ComplexSpinor m ≃ₗ[ℂ] ComplexSpinor m) :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv ℂ (ComplexSpinor m)).toMonoidHom.comp
    ((Units.map (realSpinorRepresentation m).toMonoidHom).comp spinGroup.toUnits)

/-- The spin action carries each actual exterior parity subspace onto itself. -/
theorem complexSpinRepresentation_evenOdd (m : ℕ)
    (g : spinGroup (realSpinorQuadraticForm m)) (i : ZMod 2) :
    (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) i).map
      (complexSpinRepresentation m g).toLinearMap =
        CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) i := by
  /- Stage 1: mathlib's spin group is contained in the native even Clifford
  subalgebra. Apply realSpinorRepresentation_mem_evenOdd in Clifford degree
  zero. The resulting inclusion is for the very endomorphism underlying the
  units-map construction of complexSpinRepresentation.
  Stage 2: apply the same inclusion to the inverse spin element. The two
  actions are mutual inverses by their monoid-homomorphism laws, so each
  parity vector has a preimage of the same parity. This proves equality of
  submodules and permits actual restriction to complex linear equivalences. -/
  -- Even Clifford elements preserve each original exterior parity submodule.
  have hpres (h : spinGroup (realSpinorQuadraticForm m)) (s : ComplexSpinor m)
      (hs : s ∈ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ
        (EuclideanSpace ℂ (Fin m))) i) :
      complexSpinRepresentation m h s ∈ CliffordAlgebra.evenOdd
        (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) i := by
    change realSpinorRepresentation m (h : CliffordAlgebra (realSpinorQuadraticForm m)) s ∈ _
    simpa only [zero_add] using realSpinorRepresentation_mem_evenOdd m 0 i
      (h : CliffordAlgebra (realSpinorQuadraticForm m)) (spinGroup.mem_even h.property) s hs
  apply le_antisymm
  · rintro s ⟨t, ht, rfl⟩
    exact hpres g t ht
  · -- Apply the same preservation to the original inverse spin element to obtain surjectivity.
    intro s hs
    refine ⟨complexSpinRepresentation m g⁻¹ s, hpres g⁻¹ s hs, ?_⟩
    change complexSpinRepresentation m g (complexSpinRepresentation m g⁻¹ s) = s
    rw [map_inv]
    exact (complexSpinRepresentation m g).apply_symm_apply s

/-- The same spin action restricted to either of the two exterior parity subspaces. -/
def complexSpinParityRepresentation (m : ℕ) (i : ZMod 2) :
    spinGroup (realSpinorQuadraticForm m) →*
      ((CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) i) ≃ₗ[ℂ]
        (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (EuclideanSpace ℂ (Fin m))) i)) where
  toFun g := (complexSpinRepresentation m g).ofSubmodules _ _
    (complexSpinRepresentation_evenOdd m g i)
  map_one' := by
    -- Restriction retains the ambient action on each original vector.
    ext s
    change complexSpinRepresentation m 1 (s : ComplexSpinor m) = (s : ComplexSpinor m)
    rw [map_one]
    rfl
  map_mul' g h := by
    -- Both restricted actions compose in the same order as the ambient representation.
    ext s
    change complexSpinRepresentation m (g * h) (s : ComplexSpinor m) =
      complexSpinRepresentation m g (complexSpinRepresentation m h (s : ComplexSpinor m))
    rw [map_mul]
    rfl

/-- The original real vector space identified with its canonical Clifford image. -/
def realSpinorVectorEmbeddingEquiv (m : ℕ) :
    EuclideanSpace ℂ (Fin m) ≃ₗ[ℝ]
      LinearMap.range (CliffordAlgebra.ι (realSpinorQuadraticForm m)) :=
  LinearEquiv.ofInjective (CliffordAlgebra.ι (realSpinorQuadraticForm m)) (by
    -- The existing Clifford/exterior comparison retains each generating vector.
    intro v w h
    apply (ExteriorAlgebra.ι_inj ℝ v w).mp
    have h' := congrArg (CliffordAlgebra.equivExterior (realSpinorQuadraticForm m)) h
    simpa only [CliffordAlgebra.equivExterior, CliffordAlgebra.changeFormEquiv_apply,
      CliffordAlgebra.changeForm_ι] using h')

/-- The spin group's actual conjugation action on the original real vectors. -/
def realSpinVectorRepresentation (m : ℕ) :
    spinGroup (realSpinorQuadraticForm m) →*
      (EuclideanSpace ℂ (Fin m) ≃ₗ[ℝ] EuclideanSpace ℂ (Fin m)) := by
  let e := realSpinorVectorEmbeddingEquiv m
  let c (g : spinGroup (realSpinorQuadraticForm m)) :
      LinearMap.range (CliffordAlgebra.ι (realSpinorQuadraticForm m)) ≃ₗ[ℝ]
        LinearMap.range (CliffordAlgebra.ι (realSpinorQuadraticForm m)) :=
    (DistribMulAction.toLinearEquiv ℝ (CliffordAlgebra (realSpinorQuadraticForm m))
      (ConjAct.toConjAct (spinGroup.toUnits g))).ofSubmodules _ _ (by
        -- Native spin-group conjugation preserves this exact Clifford image.
        have hmap :
            (DistribMulAction.toLinearEquiv ℝ (CliffordAlgebra (realSpinorQuadraticForm m))
              (ConjAct.toConjAct (spinGroup.toUnits g))).toLinearMap =
            DistribSMul.toLinearMap ℝ (CliffordAlgebra (realSpinorQuadraticForm m))
              (ConjAct.toConjAct (spinGroup.toUnits g)) := by
          ext a
          rfl
        rw [hmap]
        simpa only [Submodule.pointwise_smul_def] using
          (spinGroup.conjAct_smul_range_ι (x := spinGroup.toUnits g) g.property))
  exact {
    toFun := fun g ↦ e.trans ((c g).trans e.symm)
    map_one' := by
      -- Transport the identity conjugation through the fixed vector embedding.
      apply LinearEquiv.ext
      intro v
      apply e.injective
      apply Subtype.ext
      change (e (e.symm (c 1 (e v))) : CliffordAlgebra (realSpinorQuadraticForm m)) = e v
      rw [e.apply_symm_apply]
      change ConjAct.toConjAct
          (spinGroup.toUnits (1 : spinGroup (realSpinorQuadraticForm m))) •
        (e v : CliffordAlgebra (realSpinorQuadraticForm m)) = e v
      simp only [map_one, one_smul]
    map_mul' := by
      -- The intermediate vector-image equivalences cancel before composing conjugations.
      intro g h
      apply LinearEquiv.ext
      intro v
      apply e.injective
      apply Subtype.ext
      change (e (e.symm (c (g * h) (e v))) :
          CliffordAlgebra (realSpinorQuadraticForm m)) =
        e (e.symm (c g (e (e.symm (c h (e v))))))
      simp only [e.apply_symm_apply]
      change ConjAct.toConjAct (spinGroup.toUnits (g * h)) •
          (e v : CliffordAlgebra (realSpinorQuadraticForm m)) =
        ConjAct.toConjAct (spinGroup.toUnits g) •
          (ConjAct.toConjAct (spinGroup.toUnits h) •
            (e v : CliffordAlgebra (realSpinorQuadraticForm m)))
      simp only [map_mul, mul_smul] }

/-- The specified vector action is Clifford conjugation and preserves the real metric. -/
theorem realSpinVectorRepresentation_properties (m : ℕ)
    (g : spinGroup (realSpinorQuadraticForm m)) (v : EuclideanSpace ℂ (Fin m)) :
    CliffordAlgebra.ι (realSpinorQuadraticForm m) (realSpinVectorRepresentation m g v) =
        (g : CliffordAlgebra (realSpinorQuadraticForm m)) *
          CliffordAlgebra.ι (realSpinorQuadraticForm m) v *
            ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
              CliffordAlgebra (realSpinorQuadraticForm m)) ∧
      realSpinorQuadraticForm m (realSpinVectorRepresentation m g v) =
        realSpinorQuadraticForm m v ∧
      ‖realSpinVectorRepresentation m g v‖ = ‖v‖ := by
  /- Stage 1: the vector embedding equivalence and the restriction of native
  conjugation cancel by construction. Thus the displayed Clifford image is
  exactly g iota(v) g^{-1}, with the same g used by the spinor representation.
  Stage 2: square this identity. The adjacent inverse elements cancel, and
  the Clifford relation says that the square of each vector is its scalar
  quadratic value. Scalar inclusion is injective over the nontrivial real
  Clifford algebra, so the two negative quadratic values agree.
  Stage 3: each quadratic value is -||v||^2. Nonnegativity of both norms
  gives equality of norms, hence this real-linear equivalence is an isometry.
  No orientation, surjectivity onto SO, or kernel identification is used. -/
  -- Unwrap the original vector-image coordinates; the remaining map is native conjugation.
  have hconj :
      CliffordAlgebra.ι (realSpinorQuadraticForm m) (realSpinVectorRepresentation m g v) =
        (g : CliffordAlgebra (realSpinorQuadraticForm m)) *
          CliffordAlgebra.ι (realSpinorQuadraticForm m) v *
            ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
              CliffordAlgebra (realSpinorQuadraticForm m)) := by
    change ((realSpinorVectorEmbeddingEquiv m)
      ((realSpinorVectorEmbeddingEquiv m).symm _)).val = _
    rw [LinearEquiv.apply_symm_apply]
    rfl
  have hgg : (g : CliffordAlgebra (realSpinorQuadraticForm m)) *
      ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
        CliffordAlgebra (realSpinorQuadraticForm m)) = 1 :=
    congrArg Subtype.val (mul_inv_cancel g)
  have hgg' : ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
      CliffordAlgebra (realSpinorQuadraticForm m)) *
        (g : CliffordAlgebra (realSpinorQuadraticForm m)) = 1 :=
    congrArg Subtype.val (inv_mul_cancel g)
  -- Squaring the same conjugation identity preserves the scalar quadratic value.
  have hform : realSpinorQuadraticForm m (realSpinVectorRepresentation m g v) =
      realSpinorQuadraticForm m v := by
    apply (algebraMap ℝ (CliffordAlgebra (realSpinorQuadraticForm m))).injective
    rw [← CliffordAlgebra.ι_sq_scalar, hconj]
    calc
      _ = (g : CliffordAlgebra (realSpinorQuadraticForm m)) *
          (CliffordAlgebra.ι (realSpinorQuadraticForm m) v *
            CliffordAlgebra.ι (realSpinorQuadraticForm m) v) *
          ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
            CliffordAlgebra (realSpinorQuadraticForm m)) := by
        simp only [mul_assoc]
        rw [← mul_assoc ((g⁻¹ : spinGroup (realSpinorQuadraticForm m)) :
          CliffordAlgebra (realSpinorQuadraticForm m)) g, hgg', one_mul]
      _ = _ := by
        rw [CliffordAlgebra.ι_sq_scalar,
          ← Algebra.commutes (realSpinorQuadraticForm m v)
            (g : CliffordAlgebra (realSpinorQuadraticForm m)),
          mul_assoc, hgg, mul_one]
  refine ⟨hconj, hform, ?_⟩
  -- Equality of negative squared norms gives equality of the original nonnegative norms.
  have hnorm (w : EuclideanSpace ℂ (Fin m)) : realSpinorQuadraticForm m w = -‖w‖ ^ 2 := by
    let := InnerProductSpace.complexToReal (G := EuclideanSpace ℂ (Fin m))
    change -(inner ℝ w w) = -‖w‖ ^ 2
    rw [real_inner_self_eq_norm_sq]
  rw [hnorm, hnorm] at hform
  nlinarith [norm_nonneg (realSpinVectorRepresentation m g v), norm_nonneg v]

/-- Clifford multiplication intertwines the same vector and complex spinor actions. -/
theorem complexSpinRepresentation_cliffordSymbol (m : ℕ)
    (g : spinGroup (realSpinorQuadraticForm m)) (v : EuclideanSpace ℂ (Fin m))
    (s : ComplexSpinor m) :
    cliffordSymbol (realSpinVectorRepresentation m g v)
        (complexSpinRepresentation m g s) =
      complexSpinRepresentation m g (cliffordSymbol v s) := by
  /- Stage 1: use realSpinVectorRepresentation_properties to express the
  Clifford generator of the transformed vector as g iota(v) g^{-1}.
  Apply the actual real algebra representation to this identity.
  Stage 2: the generators are the original cliffordSymbol maps, and the
  images of g and g^{-1} are the mutually inverse complex spin actions.
  Evaluate the resulting endomorphism identity on the transformed spinor
  and cancel the inverse pair. Both sides retain the same original vector,
  spin element, spinor carrier, and negative-square Clifford convention.
  This is the compatibility required for associated-bundle descent. -/
  -- Apply the same real Clifford representation to the native conjugation identity.
  have hconj := congrArg (realSpinorRepresentation m)
    (realSpinVectorRepresentation_properties m g v).1
  rw [realSpinorRepresentation_ι, map_mul, map_mul,
    realSpinorRepresentation_ι] at hconj
  rw [hconj]
  change complexSpinRepresentation m g
      (cliffordSymbol v (complexSpinRepresentation m g⁻¹
        (complexSpinRepresentation m g s))) =
    complexSpinRepresentation m g (cliffordSymbol v s)
  -- The specified inverse spin element acts by the inverse of this very linear equivalence.
  have hinv : complexSpinRepresentation m g⁻¹ (complexSpinRepresentation m g s) = s := by
    rw [map_inv]
    exact (complexSpinRepresentation m g).symm_apply_apply s
  rw [hinv]

end AtiyahSinger
