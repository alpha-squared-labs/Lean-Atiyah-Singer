module

public import AtiyahSinger.Algebra.FiniteContinuousRepresentation
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The additive Grothendieck group of finite continuous complex representations

Public module ID: M0053.

Start with the free abelian group on finite continuous representations, and
impose actual continuous-linear equivariant isomorphism and direct-sum
relations. This is the additive group underlying the representation ring
used in SG III.9, printed pp.211--212. The tensor multiplication is
constructed in `RepresentationRing`.

An arbitrary finite-dimensional normed complex representation contributes
its class through one actual continuous linear coordinate equivalence.
Coordinate independence and equivariant isomorphism invariance identify the
resulting presentations; the original action retains its explicit joint
continuity hypothesis. Dimension descends from the actual finite models to
an integer-valued additive homomorphism.

No compactness, invariant inner product, semisimplicity or irreducible basis
is assumed. The presentation is the split Grothendieck group under direct
sum, and does not impose arbitrary nonsplit exact-sequence relations. The quotient
and coordinate comparison proofs retain these explicit constructions.
-/

@[expose] public noncomputable section

namespace AtiyahSinger


set_option linter.unusedSectionVars false

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The subgroup generated by actual representation isomorphisms and direct-sum relations. -/
def representationRelations : AddSubgroup (FreeAbelianGroup (FiniteContinuousRepresentation G)) :=
  AddSubgroup.closure
    ({x | ∃ ρ σ : FiniteContinuousRepresentation G,
      ρ.IsEquivalent σ ∧ x = FreeAbelianGroup.of ρ - FreeAbelianGroup.of σ} ∪
    {x | ∃ ρ σ : FiniteContinuousRepresentation G,
      x = FreeAbelianGroup.of (ρ.directSum σ) - FreeAbelianGroup.of ρ - FreeAbelianGroup.of σ})

/-- The additive Grothendieck group of finite jointly continuous complex representations. -/
abbrev RepresentationGrothendieckGroup : Type _ :=
  FreeAbelianGroup (FiniteContinuousRepresentation G) ⧸ representationRelations G

variable {G}

/-- The class of a representation on its specified finite coordinate model. -/
def finiteRepresentationClass (ρ : FiniteContinuousRepresentation G) :
    RepresentationGrothendieckGroup G :=
  QuotientAddGroup.mk' (representationRelations G) (FreeAbelianGroup.of ρ)

/-- Actual continuous equivariant isomorphisms give the same finite representation class. -/
theorem finiteRepresentationClass_eq_of_isEquivalent
    (ρ σ : FiniteContinuousRepresentation G) (h : ρ.IsEquivalent σ) :
    finiteRepresentationClass ρ = finiteRepresentationClass σ := by
  /- Their difference is one of the original isomorphism generators of
  representationRelations. Its image under the quotient map is zero, giving
  the displayed equality of the two specified presentation classes. -/
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  apply AddSubgroup.subset_closure
  exact Or.inl ⟨ρ, σ, h, rfl⟩

/-- The specified ordered direct sum becomes addition in the Grothendieck group. -/
theorem finiteRepresentationClass_directSum (ρ σ : FiniteContinuousRepresentation G) :
    finiteRepresentationClass (ρ.directSum σ) =
      finiteRepresentationClass ρ + finiteRepresentationClass σ := by
  /- The difference between the two sides is the image of the defining
  direct-sum relation for these very ρ and σ. It vanishes in the quotient.
  This uses the actual ordered block representation, not a replacement sum. -/
  apply sub_eq_zero.mp
  change (QuotientAddGroup.mk' (representationRelations G)) _ -
    ((QuotientAddGroup.mk' (representationRelations G)) _ +
      (QuotientAddGroup.mk' (representationRelations G)) _) = 0
  rw [← map_add, ← map_sub]
  apply (QuotientAddGroup.eq_zero_iff _).mpr
  apply AddSubgroup.subset_closure
  exact Or.inr ⟨ρ, σ, by abel⟩

/-- Additive isomorphism invariants extend uniquely to the representation Grothendieck group. -/
theorem representationGrothendieckGroup_universal_property {A : Type*} [AddCommGroup A]
    (v : FiniteContinuousRepresentation G → A)
    (hiso : ∀ ρ σ, ρ.IsEquivalent σ → v ρ = v σ)
    (hadd : ∀ ρ σ, v (ρ.directSum σ) = v ρ + v σ) :
    ∃! φ : RepresentationGrothendieckGroup G →+ A,
      ∀ ρ, φ (finiteRepresentationClass ρ) = v ρ := by
  /- Stage 1: extend v to the free abelian group by its universal property.
  The two hypotheses kill precisely the isomorphism and direct-sum generators,
  hence their generated subgroup. Descend this same homomorphism to the quotient.
  Stage 2: the original representation classes generate the quotient additively,
  so agreement on every such class gives uniqueness. No cancellation theorem,
  irreducible decomposition or unstabilized equality of representations is used. -/
  -- Extend the original assignment and kill both families of relations.
  let f : FreeAbelianGroup (FiniteContinuousRepresentation G) →+ A :=
    FreeAbelianGroup.lift v
  have hrelations : representationRelations G ≤ f.ker := by
    apply (AddSubgroup.closure_le _).mpr
    rintro x (⟨ρ, σ, hρσ, rfl⟩ | ⟨ρ, σ, rfl⟩)
    · change f (_ - _) = 0
      simp [f, hiso ρ σ hρσ]
    · change f (_ - _ - _) = 0
      simp [f, hadd ρ σ]
  -- Descend the same map, then compare on the original free generators.
  let φ : RepresentationGrothendieckGroup G →+ A :=
    QuotientAddGroup.lift (representationRelations G) f hrelations
  have hφ (ρ) : φ (finiteRepresentationClass ρ) = v ρ :=
    FreeAbelianGroup.lift_apply_of v ρ
  refine ⟨φ, hφ, ?_⟩
  intro ψ hψ
  apply QuotientAddGroup.addMonoidHom_ext
  apply FreeAbelianGroup.lift_ext
  intro ρ
  exact (hψ ρ).trans (hφ ρ).symm

variable (G) in
/-- Ordinary complex dimension kills the defining representation relations. -/
theorem representationRelations_le_ker_dimension :
    representationRelations G ≤
      (FreeAbelianGroup.lift (fun ρ : FiniteContinuousRepresentation G ↦
        (ρ.dimension : ℤ))).ker := by
  /- A continuous equivariant isomorphism is in particular a complex linear
  equivalence, so the finite coordinate dimensions coincide. The specified
  direct sum has dimension exactly ρ.dimension + σ.dimension. Both relation
  families have dimension difference zero; the kernel contains their closure. -/
  apply (AddSubgroup.closure_le _).mpr
  rintro x (⟨ρ, σ, ⟨e⟩, rfl⟩ | ⟨ρ, σ, rfl⟩)
  · have hdim : ρ.dimension = σ.dimension := by
      simpa using e.toContinuousLinearEquiv.toLinearEquiv.finrank_eq
    change (FreeAbelianGroup.lift _) (_ - _) = 0
    simp [hdim]
  · change (FreeAbelianGroup.lift _) (_ - _ - _) = 0
    simp [FiniteContinuousRepresentation.directSum, FiniteContinuousRepresentation.ofEquiv]

variable (G) in
/-- Dimension augmentation of the actual additive representation Grothendieck group. -/
def representationDimension : RepresentationGrothendieckGroup G →+ ℤ :=
  QuotientAddGroup.lift (representationRelations G)
    (FreeAbelianGroup.lift (fun ρ : FiniteContinuousRepresentation G ↦ (ρ.dimension : ℤ)))
    (fun _ hx ↦ representationRelations_le_ker_dimension G hx)

/-- Dimension augmentation evaluates a finite-model generator at its actual dimension. -/
theorem representationDimension_finiteClass (ρ : FiniteContinuousRepresentation G) :
    representationDimension G (finiteRepresentationClass ρ) = (ρ.dimension : ℤ) := by
  /- Evaluate the quotient lift on the original free generator ρ, then use
  the free abelian group lift computation. The value is its given dimension. -/
  exact FreeAbelianGroup.lift_apply_of
    (fun σ : FiniteContinuousRepresentation G ↦ (σ.dimension : ℤ)) ρ

variable {E F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [FiniteDimensional ℂ F]

/-- The class of an original finite-dimensional jointly continuous action, in any universe. -/
def representationClass (ρ : ContRepresentation ℂ G E)
    (hρ : Continuous (fun p : G × E ↦ ρ p.1 p.2)) :
    RepresentationGrothendieckGroup G :=
  let e : E ≃L[ℂ] (Fin (Module.finrank ℂ E) → ℂ) :=
    ContinuousLinearEquiv.ofFinrankEq (Module.finrank_fin_fun ℂ).symm
  finiteRepresentationClass (FiniteContinuousRepresentation.ofEquiv ρ hρ e)

/-- Any supplied continuous linear coordinates give the same class of the original action. -/
theorem representationClass_ofEquiv (ρ : ContRepresentation ℂ G E)
    (hρ : Continuous (fun p : G × E ↦ ρ p.1 p.2))
    {n : ℕ} (e : E ≃L[ℂ] (Fin n → ℂ)) :
    representationClass ρ hρ =
      finiteRepresentationClass (FiniteContinuousRepresentation.ofEquiv ρ hρ e) := by
  /- Stage 1: compose the inverse of the coordinates chosen by representationClass
  with the supplied e. This is an actual continuous complex-linear equivalence
  between the two finite models, even if their dimensions are written differently.
  Stage 2: both actions are conjugates of the same original ρ. The two inverse
  identities cancel the coordinates, proving that this equivalence intertwines
  every group element. The defining isomorphism relation gives the class equality.
  Joint continuity is transported from the same hρ, not inferred from the name
  ContRepresentation. Zero-dimensional spaces require no separate convention. -/
  let e₀ : E ≃L[ℂ] (Fin (Module.finrank ℂ E) → ℂ) :=
    ContinuousLinearEquiv.ofFinrankEq (Module.finrank_fin_fun ℂ).symm
  apply finiteRepresentationClass_eq_of_isEquivalent
  refine ⟨ContRepresentation.Equiv.mk (e₀.symm.trans e) ?_⟩
  intro g
  apply ContinuousLinearMap.ext
  intro x
  change e (e₀.symm (e₀ (ρ g (e₀.symm x)))) =
    e (ρ g (e.symm (e (e₀.symm x))))
  simp

/-- An actual continuous equivariant equivalence preserves the arbitrary-space class. -/
theorem representationClass_eq_of_equiv
    (ρ : ContRepresentation ℂ G E) (σ : ContRepresentation ℂ G F)
    (hρ : Continuous (fun p : G × E ↦ ρ p.1 p.2))
    (hσ : Continuous (fun p : G × F ↦ σ p.1 p.2))
    (e : ContRepresentation.Equiv ρ σ) :
    representationClass ρ hρ = representationClass σ hσ := by
  /- Compose the chosen coordinates for E and F with the original equivariant
  continuous linear equivalence e. Its native intertwining identity conjugates
  to an intertwining identity between the two specified finite presentations.
  Their difference is therefore an original isomorphism relation. The result
  compares the original actions, without substituting unrelated finite spaces. -/
  let eE : E ≃L[ℂ] (Fin (Module.finrank ℂ E) → ℂ) :=
    ContinuousLinearEquiv.ofFinrankEq (Module.finrank_fin_fun ℂ).symm
  let eF : F ≃L[ℂ] (Fin (Module.finrank ℂ F) → ℂ) :=
    ContinuousLinearEquiv.ofFinrankEq (Module.finrank_fin_fun ℂ).symm
  apply finiteRepresentationClass_eq_of_isEquivalent
  refine ⟨ContRepresentation.Equiv.mk
    ((eE.symm.trans e.toContinuousLinearEquiv).trans eF) ?_⟩
  intro g
  apply ContinuousLinearMap.ext
  intro x
  change eF (e (eE.symm (eE (ρ g (eE.symm x))))) =
    eF (σ g (eF.symm (eF (e (eE.symm x)))))
  simp only [ContinuousLinearEquiv.symm_apply_apply]
  exact congrArg eF (DFunLike.congr_fun (e.isIntertwining g) (eE.symm x))

/-- Dimension of an arbitrary-space representation class is its complex vector-space dimension. -/
theorem representationDimension_class (ρ : ContRepresentation ℂ G E)
    (hρ : Continuous (fun p : G × E ↦ ρ p.1 p.2)) :
    representationDimension G (representationClass ρ hρ) = (Module.finrank ℂ E : ℤ) := by
  /- The actual chosen finite presentation has dimension Module.finrank ℂ E
  by construction. Evaluate representationDimension on that same generator
  with representationDimension_finiteClass. No action property changes dimension. -/
  exact representationDimension_finiteClass _

end AtiyahSinger
