module

public import AtiyahSinger.Algebra.RealSpinor

/-!
# The zero-dimensional endpoint of the original generated spin group

Public module ID: M0062.

The original mathlib spinGroup includes membership in the Lipschitz subgroup
generated by invertible vector images. In dimension zero that generating set
is empty, so the group is the identity subgroup. Evenness and Clifford unitarity alone
would not give this conclusion: their intersection would also contain -1.

Source: Lawson--Michelsohn, Spin Geometry, I.2, the definition by products of
unit vectors. The zero-dimensional consequence below is an explicit endpoint
calculation from the native generated-subgroup definition, not a separately
numbered theorem in that source. It agrees with the empty-product convention.
It does not extend a stable two-sheeted covering convention to dimension zero.

No new group carrier or action is introduced. The subsingleton instance is
only an implementation adapter for this same group; the original spinor and
parity representations consequently act by their existing identity operators.
-/

@[expose] public section

namespace AtiyahSinger

/-- The original unit-generated spin group in dimension zero is the identity subgroup. -/
theorem spinGroup_zero_eq_bot : spinGroup (realSpinorQuadraticForm 0) = ⊥ := by
  /- Stage 1: the original real vector space is EuclideanSpace C (Fin 0),
  so every vector and every canonical Clifford vector image is zero.
  The real Clifford algebra is nontrivial, hence zero is not the value of
  a unit. Thus the generating set in lipschitzGroup is empty.
  Stage 2: the subgroup generated by the empty set consists only of one.
  Its image under the original units inclusion is the identity submonoid.
  Both the unitary and even submonoids contain one, so intersecting with
  them in pinGroup and then spinGroup still gives that same submonoid.
  In particular no membership of -1 is inferred merely from evenness and
  the unitary condition. No alternate rank-zero group is substituted. -/
  -- There are no invertible vector images in the zero-dimensional Clifford algebra.
  have hgenerators : ((↑) ⁻¹' Set.range (CliffordAlgebra.ι (realSpinorQuadraticForm 0)) :
      Set (CliffordAlgebra (realSpinorQuadraticForm 0))ˣ) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro u hu
    obtain ⟨v, hv⟩ := hu
    have hvzero : v = 0 := Subsingleton.elim v 0
    rw [hvzero, map_zero] at hv
    exact u.ne_zero hv.symm
  -- The generated subgroup is trivial before imposing unitary and even conditions.
  have hlipschitz : lipschitzGroup (realSpinorQuadraticForm 0) = ⊥ := by
    rw [lipschitzGroup, hgenerators, Subgroup.closure_empty]
  simp [spinGroup, pinGroup, hlipschitz]

/-- The same native zero-dimensional group has a unique element. -/
instance spinGroup_zero_subsingleton : Subsingleton (spinGroup (realSpinorQuadraticForm 0)) where
  allEq g h := by
    -- The endpoint theorem identifies both original Clifford values with one.
    apply Subtype.ext
    have hg : (g : CliffordAlgebra (realSpinorQuadraticForm 0)) = 1 :=
      Submonoid.mem_bot.mp (spinGroup_zero_eq_bot.le g.property)
    have hh : (h : CliffordAlgebra (realSpinorQuadraticForm 0)) = 1 :=
      Submonoid.mem_bot.mp (spinGroup_zero_eq_bot.le h.property)
    exact hg.trans hh.symm

end AtiyahSinger
