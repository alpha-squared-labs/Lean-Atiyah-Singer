module

public import AtiyahSinger.Analysis.GlobalSymbol
public import AtiyahSinger.Analysis.SymbolTopology

/-!
# The seminorm topology of global Hom-valued symbols

Public module ID: M0682.

Pull back local symbol seminorms through every valid base chart and
pair of bundle frames. This uses the existing genuine cotangent-fiber symbols.
The topology is explicit and selected only locally as an instance. No pointwise
function topology, Hermitian metric, density, or compact base is used here.
The construction is the standard chartwise symbol topology underlying the fixed
quantization estimate, derived from SG III.3.2 and Definition 3.18.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

open Bundle Filter
open scoped Manifold ContDiff Topology

set_option maxSynthPendingDepth 15

variable {n r q : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanSpace ℝ (Fin n)) M]
  (E F : M → Type*)
  [∀ x, NormedAddCommGroup (E x)] [∀ x, NormedSpace ℂ (E x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℂ (Fin r)) E)]
  [FiberBundle (EuclideanSpace ℂ (Fin r)) E]
  [VectorBundle ℂ (EuclideanSpace ℂ (Fin r)) E]
  [∀ x, NormedAddCommGroup (F x)] [∀ x, NormedSpace ℂ (F x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℂ (Fin q)) F)]
  [FiberBundle (EuclideanSpace ℂ (Fin q)) F]
  [VectorBundle ℂ (EuclideanSpace ℂ (Fin q)) F]

/-- Bookkeeping for one chartwise seminorm, with both independent bundle ranks retained. -/
structure GlobalSymbolSeminormIndex where
  /-- A base chart. -/
  chart : OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin n))
  /-- The chart belongs to the chosen smooth atlas. -/
  mem_atlas : chart ∈ atlas (EuclideanSpace ℝ (Fin n)) M
  /-- An input bundle frame. -/
  inputFrame : Trivialization (EuclideanSpace ℂ (Fin r)) (π (EuclideanSpace ℂ (Fin r)) E)
  /-- An output bundle frame. -/
  outputFrame : Trivialization (EuclideanSpace ℂ (Fin q)) (π (EuclideanSpace ℂ (Fin q)) F)
  /-- Validity of the input frame. -/
  input_mem_atlas : MemTrivializationAtlas inputFrame
  /-- Validity of the output frame. -/
  output_mem_atlas : MemTrivializationAtlas outputFrame
  /-- Compact set and derivative orders in the common coordinate domain. -/
  localIndex : SymbolSeminormIndex (symbolChartDomain E F chart inputFrame outputFrame)

attribute [local instance] GlobalSymbolSeminormIndex.input_mem_atlas
  GlobalSymbolSeminormIndex.output_mem_atlas

variable (m : ℝ)

/-- The actual coordinate expression, bundled as a complex-linear map of symbol modules. -/
def globalSymbolInChartLinearMap
    (J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F) :
    globalSymbolSpace (n := n) (r := r) (q := q) E F m →ₗ[ℂ]
      symbolSpace (symbolChartDomain E F J.chart J.inputFrame J.outputFrame)
        (isOpen_symbolChartDomain E F J.chart J.inputFrame J.outputFrame) m r q where
  toFun := fun p ↦ globalSymbolInChartSpace E F m p J.chart J.mem_atlas
    J.inputFrame J.outputFrame
  map_add' := fun p p' ↦ Subtype.ext
    (globalSymbolInChart_add E F p.val p'.val J.chart J.inputFrame J.outputFrame)
  map_smul' := fun a p ↦ Subtype.ext
    (globalSymbolInChart_smul E F a p.val J.chart J.inputFrame J.outputFrame)

/-- Pull a standard local symbol seminorm back along its actual coordinate map. -/
def globalSymbolSeminorm
    (J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F) :
    Seminorm ℂ (globalSymbolSpace (n := n) (r := r) (q := q) E F m) :=
  (symbolSeminorm (isOpen_symbolChartDomain E F J.chart J.inputFrame J.outputFrame)
    m J.localIndex).comp (globalSymbolInChartLinearMap E F m J)

/-- The global topology generated by all valid chartwise weighted derivative seminorms. -/
@[instance_reducible]
def globalSymbolTopology :
    TopologicalSpace (globalSymbolSpace (n := n) (r := r) (q := q) E F m) :=
  (SeminormFamily.moduleFilterBasis
    (globalSymbolSeminorm (n := n) (r := r) (q := q) E F m)).topology

-- Both domain and coordinate codomain use their seminorm topologies below.
attribute [local instance] globalSymbolTopology symbolTopology

/-- The explicitly selected global topology is generated by the displayed family. -/
theorem withSeminorms_globalSymbolTopology :
    WithSeminorms (globalSymbolSeminorm (n := n) (r := r) (q := q) E F m) := by
  /- Unfold globalSymbolTopology. The topology is by definition the module
  filter basis of the pullbacks of the local symbol seminorms. -/
  exact ⟨rfl⟩

/-- Filter convergence in the global symbol topology tests seminorms of differences. -/
theorem tendsto_globalSymbolTopology_iff {Z : Type*} (l : Filter Z)
    (p : Z → globalSymbolSpace (n := n) (r := r) (q := q) E F m)
    (b : globalSymbolSpace (n := n) (r := r) (q := q) E F m) :
    Tendsto p l (𝓝 b) ↔
      ∀ J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F,
        ∀ ε : ℝ, 0 < ε → ∀ᶠ z in l, globalSymbolSeminorm E F m J (p z - b) < ε := by
  /- Use WithSeminorms.tendsto_nhds with the preceding topology identification.
  Every compact set in every valid common chart/frame domain is tested, with
  every spatial and frequency derivative order. No parameter differentiability is used. -/
  exact (withSeminorms_globalSymbolTopology E F m).tendsto_nhds p b

/-- Reading any fixed chart is continuous for the two symbol seminorm topologies. -/
theorem continuous_globalSymbolInChartLinearMap
    (J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F) :
    Continuous (globalSymbolInChartLinearMap E F m J) := by
  /- Each codomain seminorm pulls back to the global seminorm with J's chart
  and frames and that seminorm's compact set and derivative orders. Hence it
  is one member of the domain family. Apply the seminorm continuity criterion. -/
  -- A local seminorm pulls back to the same global chart with only its local index replaced.
  have : IsTopologicalAddGroup _ :=
    (withSeminorms_globalSymbolTopology (n := n) (r := r) (q := q) E F m).isTopologicalAddGroup
  apply WithSeminorms.continuous_of_continuous_comp
    (withSeminorms_symbolTopology
      (isOpen_symbolChartDomain E F J.chart J.inputFrame J.outputFrame) m)
  intro K
  exact (withSeminorms_globalSymbolTopology E F m).continuous_seminorm
    { J with localIndex := K }

/-- On a smooth manifold, the global chartwise seminorms separate genuine symbols. -/
theorem forall_globalSymbolSeminorm_eq_zero_iff
    [IsManifold 𝓘(ℝ, EuclideanSpace ℝ (Fin n)) ∞ M]
    (p : globalSymbolSpace (n := n) (r := r) (q := q) E F m) :
    (∀ J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F,
      globalSymbolSeminorm E F m J p = 0) ↔ p = 0 := by
  /- At any base point choose a chart and both atlas frames containing it.
  The zero-order seminorm on the singleton chart coordinate detects every
  covector value. The inverse chart derivatives and invertible frame maps
  recover the original fiber map, so p vanishes everywhere. Conversely every
  seminorm vanishes at zero. Unlike the local totalized carrier, no base point is ignored. -/
  classical
  constructor
  · intro hp
    apply Subtype.ext
    funext x ξ
    -- Choose actual frames containing this base point, independently for source and target.
    let c := chartAt (EuclideanSpace ℝ (Fin n)) x
    have hc := chart_mem_atlas (EuclideanSpace ℝ (Fin n)) x
    have hx : x ∈ c.source := mem_chart_source _ x
    let e := trivializationAt (EuclideanSpace ℂ (Fin r)) E x
    let f := trivializationAt (EuclideanSpace ℂ (Fin q)) F x
    have he : x ∈ e.baseSet := mem_baseSet_trivializationAt _ _ x
    have hf : x ∈ f.baseSet := mem_baseSet_trivializationAt _ _ x
    have hz : c x ∈ symbolChartDomain E F c e f :=
      ⟨⟨c.map_source hx, by simpa only [Set.mem_preimage, c.left_inv hx] using he⟩,
        by simpa only [Set.mem_preimage, c.left_inv hx] using hf⟩
    let J : GlobalSymbolSeminormIndex (n := n) (r := r) (q := q) E F :=
      { chart := c
        mem_atlas := hc
        inputFrame := e
        outputFrame := f
        input_mem_atlas := inferInstance
        output_mem_atlas := inferInstance
        localIndex :=
          { compactSet := {c x}
            subset_domain := Set.singleton_subset_iff.mpr hz
            isCompact := isCompact_singleton
            spatialOrder := 0
            frequencyOrder := 0 } }
    have hlocal : ∀ K : SymbolSeminormIndex (symbolChartDomain E F c e f),
        symbolSeminorm (isOpen_symbolChartDomain E F c e f) m K
          (globalSymbolInChartSpace E F m p c hc e f) = 0 := by
      intro K
      exact hp { J with localIndex := K }
    have hmap := (forall_symbolSeminorm_eq_zero_iff
      (isOpen_symbolChartDomain E F c e f) m
      (globalSymbolInChartSpace E F m p c hc e f)).mp hlocal
      (c x) hz (covectorInChart c x ξ)
    change globalSymbolInChart E F p.val c e f (c x) (covectorInChart c x ξ) = 0 at hmap
    rw [globalSymbolInChart_covectorInChart E F p.val c hc e f x hx ξ] at hmap
    -- Undo those same frames to recover the original fiber map, including at zero frequency.
    ext v
    have htest := congrArg
      (fun L : EuclideanSpace ℂ (Fin r) →L[ℂ] EuclideanSpace ℂ (Fin q) ↦
        f.symmL ℂ x (L (e.continuousLinearMapAt ℂ x v))) hmap
    simpa only [ContinuousLinearMap.comp_apply, e.symmL_continuousLinearMapAt he,
      f.symmL_continuousLinearMapAt hf, zero_apply, map_zero, Pi.zero_apply,
      Submodule.coe_zero] using htest
  · rintro rfl J
    exact map_zero _

end AtiyahSinger
