/-!
# The K-theoretic Atiyah–Singer index theorem

Public module ID: M0760.

SG III.13, Theorem 13.2 and its embedding proof, printed pp.244--254.
The two existing index homomorphisms agree on the entire original compact-support
K group. The operator formula then uses the original homogeneous principal-symbol
class and smooth-section index. The explicit homogeneous representative is a real
condition on the PDO, not a consequence of general full-symbol ellipticity.

The proof compactifies a Euclidean embedding into a sphere before applying the
compact-target embedding theorem. Only the classes extended from the same
Euclidean open set are evaluated by its positive Bott coordinate; the whole
tangent K group of the sphere is not asserted to be generated by a point.
No spin structure, orientation, positive dimension, connectedness, or equality
of bundle ranks is assumed. The cohomological characteristic-number formula is
treated separately.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

open Bundle Manifold MeasureTheory Topology
open scoped Manifold ContDiff

set_option maxSynthPendingDepth 20

attribute [local instance] t2Space_cotangent locallyCompactSpace_cotangent
  tangentBundleFullChartedSpace tangentBundle_full_isManifold

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanSpace ℝ (Fin n)) M]
  [IsManifold 𝓘(ℝ, EuclideanSpace ℝ (Fin n)) ∞ M]
  [T2Space M] [SecondCountableTopology M] [CompactSpace M]
  [MeasurableSpace M] [BorelSpace M]
  (μ : Measure M) [IsSmoothPositiveMeasure (n := n) μ]

set_option maxHeartbeats 1200000 in
-- Compare the actual Euclidean embedding, its sphere compactification and their tangent K maps.
/-- Atiyah–Singer: the original analytic and topological indices agree on all tangent K classes. -/
theorem tangentAnalyticIndex_eq_topologicalIndex :
    tangentAnalyticIndex (n := n) μ = topologicalIndex (EuclideanSpace ℝ (Fin n)) M := by
  /- Stage 1: choose an actual proper Euclidean embedding f of M. Use
  topologicalIndex_eq_of_embedding to retain its specific positive Bott
  integer coordinate, and place that same Euclidean space in a sphere by
  the original normalized stereographic open embedding. The composite of
  f with this open embedding has compact source and compact target, hence
  the analytic embedding theorem applies to this composite, not directly
  to the noncompact Euclidean target.
  Stage 2: for each original tangent class u, the Euclidean Bott equivalence
  expresses f!u as its integer coordinate times the positive Bott class.
  Functoriality identifies the composite pushforward with extension of
  this same f!u through the actual tangent open embedding. Compare the
  extended positive Bott class with the point pushforward in that same
  chart, including its complex orientation and positive derivative scaling.
  Do not identify the entire sphere K group with the point coefficient group.
  Stage 3: forget the O(r) action in the actual fixed-point normalization.
  The fixed-point forgetful comparison gives precisely the ordinary point
  embedding pushforward, and equivariant-index forgetting gives its integer
  index one. Additivity therefore evaluates the composite pushforward at
  the Bott coordinate of f!u. The compact embedding theorem identifies its
  index with tangentAnalyticIndex μ u. Extensionality yields the claimed
  equality of the already defined homomorphisms, including the empty and
  disconnected cases. No equality of their implementation choices is required. -/
  classical
  let E := EuclideanSpace ℝ (Fin n)
  let embedding := compactEuclideanEmbedding E M
  let r := embedding.1
  let R := EuclideanSpace ℝ (Fin r)
  let S := OrthogonalSphere r
  let f := embedding.2.1
  have hf : IsSmoothEmbedding (𝓡 n) (𝓡 r) ∞ f := embedding.2.2.1
  have hp : IsProperMap f := embedding.2.2.2
  let : T2Space (TangentBundle (𝓡 n) M) := (tangentBundle_topology E M).1
  let : LocallyCompactSpace (TangentBundle (𝓡 n) M) :=
    ChartedSpace.locallyCompactSpace (E × E) _
  let : T2Space (TangentBundle (𝓡 r) R) := (tangentBundle_topology R R).1
  let : LocallyCompactSpace (TangentBundle (𝓡 r) R) :=
    ChartedSpace.locallyCompactSpace (R × R) _
  let : T2Space (TangentBundle (𝓡 r) S) := (tangentBundle_topology R S).1
  let : LocallyCompactSpace (TangentBundle (𝓡 r) S) :=
    ChartedSpace.locallyCompactSpace (R × R) _
  -- This same normalized open chart compactifies the original Euclidean embedding.
  let c : ContMDiffMap (𝓡 r) (𝓡 r) R S ∞ :=
    ⟨(orthogonalSphereNormalizedChart r false).symm,
      (orthogonalSphereNormalizedChart_smooth r false).2⟩
  have hc : IsLocalDiffeomorph (𝓡 r) (𝓡 r) ∞ c :=
    isLocalDiffeomorph_orthogonalSphereNormalizedChart_symm r false
  have hinj : Function.Injective c := by
    intro x y hxy
    exact (orthogonalSpherePoleDiffeomorph r false).injective (Subtype.ext hxy)
  have hopen : IsOpenEmbedding c :=
    IsOpenEmbedding.of_continuous_injective_isOpenMap c.contMDiff.continuous hinj hc.isOpenMap
  have hcEmbedding : IsSmoothEmbedding (𝓡 r) (𝓡 r) ∞ c :=
    ⟨isImmersion_of_injective_mfderiv c
      (fun x ↦ (hc.isInvertible_mfderiv (by simp) x).injective), hopen.isEmbedding⟩
  let F := c.comp f
  have hF : IsSmoothEmbedding (𝓡 n) (𝓡 r) ∞ F :=
    isSmoothEmbedding_comp f c hf hcEmbedding
  have hFp : IsProperMap F := F.contMDiff.continuous.isProperMap
  obtain ⟨ν, hν⟩ := exists_smoothPositiveMeasure (n := r) (M := S)
  let := hν
  -- Open naturality compares exactly the two geometric pushforwards on the same source.
  let idM := ContMDiffMap.id (I := 𝓡 n) (M := M) (n := ∞)
  let hid := (Diffeomorph.refl (𝓡 n) M ∞).isLocalDiffeomorph
  have hsquare := tangentEmbeddingPushforward_open_naturality F hF hFp f hf hp
    idM hid Function.injective_id c hc hinj (fun _ ↦ rfl)
  have hidT : (smoothTangentMap idM : TangentBundle (𝓡 n) M → _) = id := by
    funext z
    change tangentMap (𝓡 n) (𝓡 n) id z = z
    rw [tangentMap_id]
    rfl
  have hidK : compactSupportKZeroOpenPushforward (smoothTangentMap idM)
      (isOpenEmbedding_smoothTangentMap idM hid Function.injective_id) =
      AddMonoidHom.id (CompactSupportKZero (TangentBundle (𝓡 n) M)) := by
    simpa only [hidT] using
      (compactSupportKZeroOpenPushforward_id (X := TangentBundle (𝓡 n) M))
  let Tc : C(TangentBundle (𝓡 r) R, TangentBundle (𝓡 r) S) :=
    ⟨smoothTangentMap c, (smoothTangentMap c).contMDiff.continuous⟩
  have hTc : IsOpenEmbedding Tc := isOpenEmbedding_smoothTangentMap c hc hinj
  let eR := euclideanTangentComplexHomeomorph r
  let eC := PiLp.homeomorph 2 (fun _ : Fin r ↦ ℂ)
  let Q := eC.trans eR.symm
  have hchart : (Tc : _ → _) ∘ Q = orthogonalSphereTangentChart r false := rfl
  have hcoordinates : (compactSupportKZeroHomeomorph eC).comp
      (compactSupportKZeroHomeomorph Q.symm) = compactSupportKZeroHomeomorph eR := by
    rw [← compactSupportKZeroOpenPushforward_homeomorph,
      ← compactSupportKZeroOpenPushforward_homeomorph,
      ← compactSupportKZeroOpenPushforward_comp,
      ← compactSupportKZeroOpenPushforward_homeomorph]
    congr 1
  rw [topologicalIndex_eq_of_embedding f hf hp]
  apply AddMonoidHom.ext
  intro u
  let v := tangentEmbeddingPushforward f hf hp u
  let w := compactSupportKZeroHomeomorph Q.symm v
  have hQ : compactSupportKZeroHomeomorph Q w = v :=
    DFunLike.congr_fun (compactSupportKZeroHomeomorph_symm Q.symm) v
  have hpush := DFunLike.congr_fun hsquare u
  change compactSupportKZeroOpenPushforward Tc hTc v =
    tangentEmbeddingPushforward F hF hFp
      (compactSupportKZeroOpenPushforward (smoothTangentMap idM) _ u) at hpush
  rw [hidK, AddMonoidHom.id_apply] at hpush
  have hchartValue : compactSupportKZeroOpenPushforward Tc hTc v =
      compactSupportKZeroOpenPushforward (orthogonalSphereTangentChart r false)
        (orthogonalSphereTangentChart_isOpenEmbedding r false) w := by
    rw [← hQ, ← compactSupportKZeroOpenPushforward_homeomorph,
      ← AddMonoidHom.comp_apply, ← compactSupportKZeroOpenPushforward_comp]
    congr 1
  have hindex := tangentAnalyticIndex_tangentEmbeddingPushforward F hF hFp μ ν u
  -- Only this actual open-chart image is evaluated by the positive Bott coordinate.
  calc
    tangentAnalyticIndex μ u = tangentAnalyticIndex ν
        (tangentEmbeddingPushforward F hF hFp u) := hindex.symm
    _ = tangentAnalyticIndex ν
        (compactSupportKZeroOpenPushforward (orthogonalSphereTangentChart r false)
          (orthogonalSphereTangentChart_isOpenEmbedding r false) w) := by
      rw [← hpush, hchartValue]
    _ = bottEuclideanClassEquivInt r (compactSupportKZeroHomeomorph eC w) :=
      tangentAnalyticIndex_sphereTangentChart r false ν w
    _ = topologicalIndexOfEmbedding f hf hp u := by
      have hcoord := DFunLike.congr_fun hcoordinates v
      change compactSupportKZeroHomeomorph eC w = compactSupportKZeroHomeomorph eR v at hcoord
      rw [hcoord]
      rfl

/-- The same Atiyah–Singer equality on the original cotangent compact-support K group. -/
theorem analyticIndexOfComponents_eq_cotangentTopologicalIndex :
    analyticIndexOfComponents (n := n) μ = cotangentTopologicalIndex n M := by
  /- Stage 1: choose one smooth positive tangent metric g. Use
  tangentAnalyticIndex_eq and cotangentTopologicalIndex_eq with this same g.
  Both sides use the existing tangentCotangentKZeroEquiv g, not independently
  chosen musical maps or different K classes.
  Stage 2: compose the tangent index equality with its inverse K equivalence.
  Cancel that equivalence with its own inverse. The result is an equality
  of the two original cotangent homomorphisms. The source positive Bott sign
  is transported unchanged; no new orientation on M is selected. -/
  classical
  let g : SmoothTangentMetric (n := n) (M := M) :=
    Classical.choice SmoothTangentMetric.nonempty
  -- Evaluate the tangent equality at the inverse of this same musical equivalence.
  have hindex := tangentAnalyticIndex_eq_topologicalIndex (n := n) (M := M) μ
  rw [tangentAnalyticIndex_eq μ g] at hindex
  rw [cotangentTopologicalIndex_eq g]
  apply AddMonoidHom.ext
  intro u
  have hvalue := DFunLike.congr_fun hindex ((tangentCotangentKZeroEquiv g).symm u)
  simpa only [AddMonoidHom.comp_apply, AddEquiv.toAddMonoidHom_eq_coe,
    AddMonoidHom.coe_ofClass, AddEquiv.apply_symm_apply] using hvalue

variable {r q : ℕ} {E : M → Type*}
  [∀ x, NormedAddCommGroup (E x)] [∀ x, NormedSpace ℂ (E x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℂ (Fin r)) E)]
  [FiberBundle (EuclideanSpace ℂ (Fin r)) E]
  [VectorBundle ℂ (EuclideanSpace ℂ (Fin r)) E]
  {F : M → Type*}
  [∀ x, NormedAddCommGroup (F x)] [∀ x, NormedSpace ℂ (F x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℂ (Fin q)) F)]
  [FiberBundle (EuclideanSpace ℂ (Fin q)) F]
  [VectorBundle ℂ (EuclideanSpace ℂ (Fin q)) F]
  [IsSmoothComplexBundle (n := n) (r := r) E]
  [IsSmoothComplexBundle (n := n) (r := q) F]

/-- Atiyah–Singer for an elliptic PDO with a supplied homogeneous principal symbol. -/
theorem PseudodifferentialOperator.index_eq_cotangentTopologicalIndex {m : ℝ}
    (P : PseudodifferentialOperator (n := n) (r := r) (q := q) E F μ m)
    (R : QuantizationPresentation (n := n) (r := r) (q := q) E F)
    (a : homogeneousGlobalSymbolSpace (n := n) (r := r) (q := q) E F m)
    (hp : P.principalSymbol = globalPrincipalSymbolClass E F m
      (R.regularizedSymbol m a.val a.property.1 a.property.2)) (hi : P.IsElliptic) :
    P.toLinearMap.index =
      cotangentTopologicalIndex n M (P.symbolKClassOfHomogeneous R a hp hi) := by
  /- Stage 1: the original analytic symbol theorem evaluates
  analyticIndexOfComponents μ at exactly P.symbolKClassOfHomogeneous R a hp hi
  as the index of P.toLinearMap. Its finite-component and smoothing argument
  concerns the original operator; it is not replaced by a quantization choice.
  Stage 2: evaluate the cotangent homomorphism equality at that same class
  and reverse the analytic evaluation. The resulting integer is the existing
  positive-Bott topological index. hp records the source's classical leading
  symbol condition explicitly; full-symbol ellipticity alone does not supply
  such an a. The differential-operator specialization discharges this condition
  using its original homogeneous principal polynomial. -/
  -- The original operator evaluation uses precisely the supplied homogeneous class.
  have heval := PseudodifferentialOperator.analyticIndexOfComponents_symbolKClassOfHomogeneous
    μ P R a hp hi
  rw [analyticIndexOfComponents_eq_cotangentTopologicalIndex μ] at heval
  exact heval.symm

end AtiyahSinger
