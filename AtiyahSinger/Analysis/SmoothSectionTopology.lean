module

public import AtiyahSinger.Analysis.CkSections
public import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-!
# The smooth topology on sections over a compact base

Public module ID: M0984.

D01/D04/A01: the usual C-infinity topology on actual smooth sections, generated by
all finite-order norms of a finite presentation. The type tag prevents accidental
use of the pointwise topology of arbitrary sections. A finite compact cutoff
presentation already forces compactness; no noncompact test topology is claimed.
Sources: Taylor I.1, Definitions 1.1--1.3, pp.10--12; SG III.2.2, 2.14--2.15.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

open Bundle Filter
open scoped Manifold ContDiff Topology

variable {n r : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanSpace ℝ (Fin n)) M]
  {E : M → Type*} [∀ x, NormedAddCommGroup (E x)] [∀ x, NormedSpace ℂ (E x)]
  [TopologicalSpace (TotalSpace (EuclideanSpace ℂ (Fin r)) E)]
  [FiberBundle (EuclideanSpace ℂ (Fin r)) E]
  [VectorBundle ℂ (EuclideanSpace ℂ (Fin r)) E]
  [hM : IsManifold 𝓘(ℝ, EuclideanSpace ℝ (Fin n)) ∞ M]
  [hT2 : T2Space M] [hSC : SecondCountableTopology M]
  [hE : IsSmoothComplexBundle (n := n) (r := r) E]

namespace SmoothBundlePresentation

variable (A : SmoothBundlePresentation (n := n) (r := r) E)

/-- Actual smooth sections tagged by the presentation describing their topology. -/
def SmoothSectionSpace (_A : SmoothBundlePresentation (n := n) (r := r) E) : Type _ :=
  smoothSections (n := n) (r := r) E

/-- The ordinary additive structure on the tagged smooth sections. -/
@[instance_reducible]
def smoothSectionAddCommGroup : AddCommGroup A.SmoothSectionSpace :=
  inferInstanceAs (AddCommGroup (smoothSections (n := n) (r := r) E))

attribute [instance] smoothSectionAddCommGroup

/-- Complex scalars act on the same underlying section. -/
@[instance_reducible]
def smoothSectionModule : Module ℂ A.SmoothSectionSpace :=
  inferInstanceAs (Module ℂ (smoothSections (n := n) (r := r) E))

attribute [instance] smoothSectionModule

/-- Forgetting the tag preserves the actual smooth section. -/
def smoothSectionEquiv : A.SmoothSectionSpace ≃ₗ[ℂ] smoothSections (n := n) (r := r) E :=
  LinearEquiv.refl ℂ _

/-- The usual C^k seminorm pulled back along the actual smooth inclusion. -/
def smoothSectionSeminorm (k : ℕ) : Seminorm ℂ A.SmoothSectionSpace :=
  (normSeminorm ℂ (A.CkSectionSpace k)).comp
    ((A.smoothToCk k).comp A.smoothSectionEquiv.toLinearMap)

/-- The seminorm uses the existing derivative norm, not a pointwise norm. -/
theorem smoothSectionSeminorm_apply (k : ℕ) (u : A.SmoothSectionSpace) :
    A.smoothSectionSeminorm k u = ‖A.smoothToCk k (A.smoothSectionEquiv u)‖ := by
  /- Unfold the pullback of the norm seminorm. Its argument is the original
  section viewed in the C^k space, whose norm measures derivatives through k. -/
  -- The pullback seminorm evaluates the unchanged smooth-to-finite-order inclusion.
  rfl

/-- Increasing the derivative order increases the corresponding seminorm. -/
theorem smoothSectionSeminorm_mono (k l : ℕ) (hkl : k ≤ l) (u : A.SmoothSectionSpace) :
    A.smoothSectionSeminorm k u ≤ A.smoothSectionSeminorm l u := by
  /- Both localizations have the same underlying smooth function. Derivative
  values through k form a subset of those through l. Use boundedness of the
  defining sets; an empty presentation gives zero for both suprema. -/
  classical
  have hlocal (j : Fin A.size) :
      A.localizedCkFunction k j (A.smoothToCk k (A.smoothSectionEquiv u)) =
        A.localizedCkFunction l j (A.smoothToCk l (A.smoothSectionEquiv u)) := rfl
  change A.ckNorm k (A.smoothToCk k (A.smoothSectionEquiv u)) ≤
    A.ckNorm l (A.smoothToCk l (A.smoothSectionEquiv u))
  by_cases hsize : A.size = 0
  · have : IsEmpty (Fin A.size) := Fin.isEmpty_iff.mpr hsize
    simp [ckNorm]
  · -- Every lower-order derivative value belongs to the larger bounded defining set.
    let j₀ : Fin A.size := ⟨0, Nat.pos_of_ne_zero hsize⟩
    apply csSup_le_csSup (A.bddAbove_ckNorm_values l _)
    · exact ⟨‖iteratedFDeriv ℝ 0
        (A.localizedCkFunction k j₀ (A.smoothToCk k (A.smoothSectionEquiv u))) 0‖,
        j₀, 0, Nat.zero_le k, 0, rfl⟩
    · rintro a ⟨j, i, hi, x, rfl⟩
      exact ⟨j, i, hi.trans hkl, x, by rw [hlocal]⟩

/-- The standard topology generated by all finite-order derivative seminorms. -/
@[instance_reducible]
def smoothSectionTopology : TopologicalSpace A.SmoothSectionSpace :=
  (SeminormFamily.moduleFilterBasis A.smoothSectionSeminorm).topology

attribute [instance] smoothSectionTopology

/-- The chosen topology is generated by the displayed derivative seminorms. -/
theorem withSeminorms_smoothSectionTopology : WithSeminorms A.smoothSectionSeminorm := by
  /- Unfold the module filter-basis construction. Its neighborhoods control
  finitely many derivative orders, with strictly positive bounds at each order. -/
  -- This is precisely the original seminorm-family construction of the topology.
  exact ⟨rfl⟩

/-- Smooth convergence is convergence in every finite-order section norm. -/
theorem tendsto_smoothSectionSpace_iff {Z : Type*} (l : Filter Z)
    (u : Z → A.SmoothSectionSpace) (v : A.SmoothSectionSpace) :
    Tendsto u l (𝓝 v) ↔ ∀ k : ℕ, ∀ ε : ℝ, 0 < ε →
      ∀ᶠ z in l, A.smoothSectionSeminorm k (u z - v) < ε := by
  /- Apply the convergence characterization of WithSeminorms. Every derivative
  order is tested on differences, rather than merely testing values at each point. -/
  -- Use the seminorm criterion on differences in the actual tagged section space.
  exact (A.withSeminorms_smoothSectionTopology).tendsto_nhds u v

/-- Changing presentation leaves the topology of actual smooth sections unchanged. -/
theorem smoothSectionTopology_eq (B : SmoothBundlePresentation (n := n) (r := r) E) :
    A.smoothSectionTopology = B.smoothSectionTopology := by
  /- The C^k presentation estimates bound each B seminorm by a constant times
  the A seminorm of the same order. They give continuity of the identity in one
  direction. Interchange A and B for the reverse; the section carriers agree. -/
  classical
  -- Same-order Ck comparison bounds every target seminorm by one source seminorm.
  have hbound (P Q : SmoothBundlePresentation (n := n) (r := r) E) :
      Seminorm.IsBounded P.smoothSectionSeminorm Q.smoothSectionSeminorm
        (LinearMap.id : P.SmoothSectionSpace →ₗ[ℂ] Q.SmoothSectionSpace) := by
    intro k
    obtain ⟨C, hC, hcomparison⟩ := P.exists_ck_norm_comparison Q k
    refine ⟨{k}, ⟨C, hC.le⟩, ?_⟩
    intro u
    rw [Finset.sup_singleton]
    exact hcomparison (P.smoothToCk k (P.smoothSectionEquiv u))
  -- The two identity maps are continuous in the original seminorm topologies.
  apply le_antisymm
  · apply continuous_id_iff_le.mp
    exact A.withSeminorms_smoothSectionTopology.continuous_of_isBounded
      B.withSeminorms_smoothSectionTopology (LinearMap.id) (hbound A B)
  · apply continuous_id_iff_le.mp
    exact B.withSeminorms_smoothSectionTopology.continuous_of_isBounded
      A.withSeminorms_smoothSectionTopology (LinearMap.id) (hbound B A)

/-- The standard smooth topology separates distinct sections. -/
theorem t2Space_smoothSectionSpace : T2Space A.SmoothSectionSpace := by
  /- The order-zero seminorm detects the section since the cutoff partition
  sums to one. Thus the common seminorm kernel is zero, which makes the associated
  additive-group topology Hausdorff. Empty bases cause no exception. -/
  have htop := A.withSeminorms_smoothSectionTopology
  have : IsTopologicalAddGroup A.SmoothSectionSpace := htop.isTopologicalAddGroup
  have : T1Space A.SmoothSectionSpace := htop.T1_of_separating (by
    intro u hu
    refine ⟨0, ?_⟩
    intro hzero
    -- The order-zero norm detects the original section, not merely a pointwise quotient.
    have hck : A.smoothToCk 0 (A.smoothSectionEquiv u) = 0 := by
      apply norm_eq_zero.mp
      exact hzero
    apply hu
    apply Subtype.ext
    exact congrArg (fun w : A.CkSectionSpace 0 ↦ w.val) hck)
  infer_instance

include hM hT2 hSC hE

/-- Every real Sobolev norm on smooth sections is bounded by some finite C^k norm. -/
theorem exists_sobolev_bound_smoothSectionSeminorm (s : ℝ) :
    ∃ k : ℕ, ∃ C : ℝ, 0 < C ∧ ∀ u : A.SmoothSectionSpace,
      ‖A.smoothToSobolev s (A.smoothSectionEquiv u)‖ ≤
        C * A.smoothSectionSeminorm k u := by
  /- Each localization has the same fixed compact support for every section.
  Consequently every Schwartz seminorm is bounded by a finite-order section
  seminorm. Compose these continuous localizations with the actual Bessel
  multiplier and L² embedding, then extract a finite seminorm bound. This
  proves the estimate without requiring a Sobolev change-of-presentation bound. -/
  classical
  let X := EuclideanSpace ℝ (Fin n)
  let V := EuclideanSpace ℂ (Fin r)
  let p := A.smoothSectionSeminorm
  have hp := A.withSeminorms_smoothSectionTopology
  -- On the fixed compact support, polynomial Schwartz weights are uniformly bounded.
  have hlocal (j : Fin A.size) :
      Continuous (fun u : A.SmoothSectionSpace ↦
        A.localize j (A.smoothSectionEquiv u)) := by
    let K := (A.chart j) '' tsupport (A.cutoff j)
    have hK : IsCompact K :=
      (A.compact_support j).image_of_continuousOn
        ((A.chart j).continuousOn.mono (fun x hx ↦ (A.support_subset j hx).1))
    obtain ⟨R, hRpos, hR⟩ := hK.isBounded.exists_pos_norm_le
    let T : A.SmoothSectionSpace →ₗ[ℂ] SchwartzMap X V :=
      (A.localizeLinearMap j).comp A.smoothSectionEquiv.toLinearMap
    apply hp.continuous_of_isBounded (schwartz_withSeminorms ℂ X V) T
    rintro ⟨a, b⟩
    refine ⟨{b}, ⟨R ^ a, pow_nonneg hRpos.le a⟩, ?_⟩
    intro u
    rw [Finset.sup_singleton]
    change SchwartzMap.seminorm ℂ a b (A.localize j (A.smoothSectionEquiv u)) ≤
      R ^ a * A.smoothSectionSeminorm b u
    have hnonneg : 0 ≤ R ^ a * A.smoothSectionSeminorm b u :=
      mul_nonneg (pow_nonneg hRpos.le a) (apply_nonneg _ u)
    apply SchwartzMap.seminorm_le_bound ℂ a b _ hnonneg
    intro x
    by_cases hx : x ∈ K
    · -- The original C^b supremum controls the identical localized derivative.
      have hderiv :
          ‖iteratedFDeriv ℝ b (A.localize j (A.smoothSectionEquiv u)) x‖ ≤ p b u := by
        change ‖iteratedFDeriv ℝ b
          (A.localizedCkFunction b j (A.smoothToCk b (A.smoothSectionEquiv u))) x‖ ≤
            A.ckNorm b (A.smoothToCk b (A.smoothSectionEquiv u))
        exact le_csSup (A.bddAbove_ckNorm_values b _)
          ⟨j, b, le_rfl, x, rfl⟩
      exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg x) (hR x hx) a)
        hderiv (norm_nonneg _) (pow_nonneg hRpos.le a)
    · -- Derivatives vanish off that same support, including near chart boundaries.
      have hzero : iteratedFDeriv ℝ b (A.localize j (A.smoothSectionEquiv u)) x = 0 := by
        apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hx (A.tsupport_localizedFunction_subset j (A.smoothSectionEquiv u)
          (tsupport_iteratedFDeriv_subset b hmem))
      simpa only [hzero, norm_zero, mul_zero] using hnonneg
  -- The specified real-order Bessel coordinate map is continuous on Schwartz space.
  let B : SchwartzMap X V →L[ℝ] MeasureTheory.Lp V 2
      (MeasureTheory.volume : MeasureTheory.Measure X) :=
    (SchwartzMap.toLpCLM ℝ V 2 MeasureTheory.volume).comp
      (SchwartzMap.fourierMultiplierCLM V
        (fun ξ : X ↦ ((1 + ‖ξ‖ ^ 2) ^ (s / 2) : ℝ)))
  have hcoordinates :
      Continuous (fun u : A.SmoothSectionSpace ↦
        A.sobolevCoordinates s (A.smoothSectionEquiv u)) := by
    change Continuous (fun u : A.SmoothSectionSpace ↦
      WithLp.toLp 2 (fun j ↦ B (A.localize j (A.smoothSectionEquiv u))))
    exact (PiLp.continuous_toLp 2 _).comp
      (continuous_pi fun j ↦ B.continuous.comp (hlocal j))
  -- Pass to the original closed Hilbert subspace, keeping the same coordinate tuple.
  let T := (A.smoothToSobolev s).comp A.smoothSectionEquiv.toLinearMap
  have hT : Continuous T := continuous_induced_rng.2 hcoordinates
  obtain ⟨orders, C, hC, hbound⟩ := Seminorm.bound_of_continuous hp
    ((normSeminorm ℂ (A.SobolevSpace s)).comp T) (continuous_norm.comp hT)
  -- Finitely many derivative orders reduce to their maximum by monotonicity.
  refine ⟨orders.sup id, (C : ℝ), by exact_mod_cast (pos_iff_ne_zero.mpr hC), ?_⟩
  intro u
  have hsup : orders.sup p ≤ p (orders.sup id) := by
    apply Finset.sup_le
    intro k hk w
    exact A.smoothSectionSeminorm_mono k (orders.sup id) (Finset.le_sup (f := id) hk) w
  exact (hbound u).trans (mul_le_mul_of_nonneg_left (hsup u) C.coe_nonneg)

/-- The original smooth inclusion into each Sobolev completion is continuous. -/
theorem continuous_smoothToSobolev (s : ℝ) :
    Continuous (fun u : A.SmoothSectionSpace ↦
      A.smoothToSobolev s (A.smoothSectionEquiv u)) := by
  /- The preceding estimate bounds the norm of this linear map by one defining
  seminorm. Apply the continuity criterion for the C-infinity topology; the
  pointwise topology inherited by arbitrary sections would not suffice. -/
  obtain ⟨k, C, hC, hbound⟩ := A.exists_sobolev_bound_smoothSectionSeminorm s
  -- A single defining seminorm bounds the original inclusion, with no change of section.
  apply A.withSeminorms_smoothSectionTopology.continuous_normedSpace_rng
    (A.SobolevSpace s) ((A.smoothToSobolev s).comp A.smoothSectionEquiv.toLinearMap)
  refine ⟨{k}, ⟨C, hC.le⟩, ?_⟩
  intro u
  rw [Finset.sup_singleton]
  exact hbound u

/-- The same inclusion packaged as a continuous linear map. -/
def smoothSectionToSobolev (s : ℝ) : A.SmoothSectionSpace →L[ℂ] A.SobolevSpace s where
  toLinearMap := (A.smoothToSobolev s).comp A.smoothSectionEquiv.toLinearMap
  cont := A.continuous_smoothToSobolev s

/-- Continuity of a linear map into a normed space is equivalent to one C^k bound. -/
theorem continuous_linearMap_iff_exists_bound
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (T : A.SmoothSectionSpace →ₗ[ℂ] V) :
    Continuous T ↔ ∃ k : ℕ, ∃ C : ℝ, 0 < C ∧
      ∀ u : A.SmoothSectionSpace, ‖T u‖ ≤ C * A.smoothSectionSeminorm k u := by
  /- Forward: continuity bounds the pullback of the target norm by finitely many
  defining seminorms. Monotonicity replaces them by the largest derivative order;
  choose order zero for an empty finite set. Reverse: the displayed bound gives
  continuity at zero, hence everywhere. The order k may depend on T. -/
  classical
  let p := A.smoothSectionSeminorm
  have hp := A.withSeminorms_smoothSectionTopology
  constructor
  · intro hT
    -- Continuity controls the target norm by finitely many of the original seminorms.
    obtain ⟨s, C, hC, hbound⟩ := Seminorm.bound_of_continuous hp
      ((normSeminorm ℂ V).comp T) (continuous_norm.comp hT)
    refine ⟨s.sup id, (C : ℝ), by exact_mod_cast (pos_iff_ne_zero.mpr hC), ?_⟩
    intro u
    have hsup : s.sup p ≤ p (s.sup id) := by
      apply Finset.sup_le
      intro k hk w
      exact A.smoothSectionSeminorm_mono k (s.sup id) (Finset.le_sup (f := id) hk) w
    exact (hbound u).trans (mul_le_mul_of_nonneg_left (hsup u) C.coe_nonneg)
  · rintro ⟨k, C, hC, hbound⟩
    -- A single-order estimate is a seminorm-family boundedness certificate.
    apply hp.continuous_normedSpace_rng V T
    refine ⟨{k}, ⟨C, hC.le⟩, ?_⟩
    intro u
    rw [Finset.sup_singleton]
    exact hbound u

end SmoothBundlePresentation

end AtiyahSinger
