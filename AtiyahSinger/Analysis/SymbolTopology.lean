module

public import AtiyahSinger.Analysis.SymbolQuotient
public import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-!
# The weighted derivative seminorm topology on symbols

Public module ID: M1028.

D05/A03/A08: make the constants in the S^m_(1,0) estimates into actual seminorms.
The topology is the one generated by these seminorms, not the inherited pointwise
topology of total functions. The carrier retains arbitrary values outside U, so
we do not assert Hausdorffness or completeness. Passing to functions on U would
require a separate quotient. These seminorms make the finite-derivative
estimate in SG III.3.2 usable for parameter families.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

open Filter
open scoped Topology ContDiff

variable {n r q : ℕ} {U : Set (EuclideanSpace ℝ (Fin n))}

/-- Indexing data for one standard symbol seminorm, not an additional symbol condition. -/
structure SymbolSeminormIndex (U : Set (EuclideanSpace ℝ (Fin n))) where
  /-- The compact spatial set on which derivatives are measured. -/
  compactSet : Set (EuclideanSpace ℝ (Fin n))
  /-- Only points in the symbol domain are measured. -/
  subset_domain : compactSet ⊆ U
  /-- Compactness supplies a finite symbol estimate. -/
  isCompact : IsCompact compactSet
  /-- Number of spatial derivatives. -/
  spatialOrder : ℕ
  /-- Number of frequency derivatives. -/
  frequencyOrder : ℕ

variable (hU : IsOpen U) (m : ℝ)

/-- The supremum of the weighted mixed derivative norms; the empty-set value is zero. -/
def symbolSeminormValue (J : SymbolSeminormIndex U) (a : symbolSpace U hU m r q) : ℝ :=
  sSup {t : ℝ | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
    t = ‖symbolDerivative a.val J.spatialOrder J.frequencyOrder x ξ‖ /
      (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))}

/-- The supremum defining a symbol seminorm is bounded above. -/
theorem bddAbove_symbolSeminormValue_set (J : SymbolSeminormIndex U)
    (a : symbolSpace U hU m r q) :
    BddAbove {t : ℝ | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
      t = ‖symbolDerivative a.val J.spatialOrder J.frequencyOrder x ξ‖ /
        (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))} := by
  /- Apply the defining symbol estimate to J.compactSet and its two orders.
  Divide by the strictly positive real power of 1+norm(ξ). The resulting
  nonnegative constant bounds every member, including when the set is empty. -/
  obtain ⟨C, hC, hbound⟩ := a.property.2 J.compactSet J.subset_domain J.isCompact
    J.spatialOrder J.frequencyOrder
  refine ⟨C, ?_⟩
  rintro t ⟨x, hx, ξ, rfl⟩
  -- The positive frequency weight permits division without reversing the estimate.
  exact (div_le_iff₀ (Real.rpow_pos_of_pos (by positivity) _)).mpr (hbound x hx ξ)

/-- Weighted derivative suprema are subadditive on symbols. -/
theorem symbolSeminormValue_add_le (J : SymbolSeminormIndex U)
    (a b : symbolSpace U hU m r q) :
    symbolSeminormValue hU m J (a + b) ≤
      symbolSeminormValue hU m J a + symbolSeminormValue hU m J b := by
  /- On the open domain, smoothness lets mixed differentiation commute with
  addition. Divide the triangle inequality by the positive weight and take
  bounded suprema. Treat the empty compact set separately, where all values are zero. -/
  classical
  by_cases hK : J.compactSet.Nonempty
  swap
  · simp [symbolSeminormValue, Set.not_nonempty_iff_eq_empty.mp hK]
  obtain ⟨x₀, hx₀⟩ := hK
  let f := a.val
  let g := b.val
  have hparametric {P Q R : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [NormedAddCommGroup Q] [NormedSpace ℝ Q] [NormedAddCommGroup R] [NormedSpace ℝ R]
      (f : P → Q → R) (x : P) (y : Q)
      (hf : ContDiffAt ℝ ∞ (Function.uncurry f) (x, y)) (j : ℕ) :
      ContDiffAt ℝ ∞ (fun p : P × Q ↦ iteratedFDeriv ℝ j (f p.1) p.2) (x, y) := by
    -- Parameter differentiation remains smooth; each step differentiates and uncurries once.
    induction j with
    | zero =>
      exact hf.continuousLinearMap_comp
        ((continuousMultilinearCurryFin0 ℝ Q R).symm : _ →L[ℝ] Q [×0]→L[ℝ] R)
    | succ j ih =>
      have h : ContDiffAt ℝ ∞
          (Function.uncurry (fun p : P × Q ↦ fun z : Q ↦ iteratedFDeriv ℝ j (f p.1) z))
          ((x, y), y) := ih.comp ((x, y), y) (contDiffAt_fst.fst.prodMk contDiffAt_snd)
      have hd : ContDiffAt ℝ ∞
          (fun p : P × Q ↦ fderiv ℝ (iteratedFDeriv ℝ j (f p.1)) p.2) (x, y) :=
        h.fderiv contDiffAt_snd (by simp)
      exact hd.continuousLinearMap_comp
        ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (j + 1) ↦ Q) R).symm :
          _ →L[ℝ] Q [×(j + 1)]→L[ℝ] R)
  have hfg (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ U)
      (ξ : EuclideanSpace ℝ (Fin n)) :
      ContDiffAt ℝ ∞ (Function.uncurry f) (x, ξ) ∧
        ContDiffAt ℝ ∞ (Function.uncurry g) (x, ξ) :=
    ⟨a.property.1.contDiffAt ((hU.prod isOpen_univ).mem_nhds ⟨hx, Set.mem_univ ξ⟩),
      b.property.1.contDiffAt ((hU.prod isOpen_univ).mem_nhds ⟨hx, Set.mem_univ ξ⟩)⟩
  -- Differentiate first in frequency and then in the spatial variable on the same open domain.
  have hder (i j : ℕ) (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ U)
      (ξ : EuclideanSpace ℝ (Fin n)) :
      symbolDerivative (f + g) i j x ξ =
        symbolDerivative f i j x ξ + symbolDerivative g i j x ξ := by
    have hnear : (fun y ↦ iteratedFDeriv ℝ j ((f + g) y) ξ) =ᶠ[𝓝 x]
        (fun y ↦ iteratedFDeriv ℝ j (f y) ξ + iteratedFDeriv ℝ j (g y) ξ) := by
      filter_upwards [hU.mem_nhds hx] with y hy
      exact iteratedFDeriv_add_apply
        (((hfg y hy ξ).1.comp ξ (contDiffAt_const.prodMk contDiffAt_id)).of_le (by simp))
        (((hfg y hy ξ).2.comp ξ (contDiffAt_const.prodMk contDiffAt_id)).of_le (by simp))
    have hf := (hparametric f x ξ (hfg x hx ξ).1 j).comp x
      (contDiffAt_id.prodMk contDiffAt_const)
    have hg := (hparametric g x ξ (hfg x hx ξ).2 j).comp x
      (contDiffAt_id.prodMk contDiffAt_const)
    exact ((hnear.iteratedFDeriv ℝ i).eq_of_nhds).trans
      (iteratedFDeriv_add_apply (hf.of_le (by simp)) (hg.of_le (by simp)))
  -- Compare each weighted derivative to the sum of the two bounded suprema.
  unfold symbolSeminormValue
  refine csSup_le ⟨_, x₀, hx₀, 0, rfl⟩ ?_
  rintro t ⟨x, hx, ξ, rfl⟩
  change ‖symbolDerivative (f + g) J.spatialOrder J.frequencyOrder x ξ‖ / _ ≤ _
  rw [hder J.spatialOrder J.frequencyOrder x (J.subset_domain hx) ξ]
  calc
    ‖symbolDerivative f J.spatialOrder J.frequencyOrder x ξ +
        symbolDerivative g J.spatialOrder J.frequencyOrder x ξ‖ /
        (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ)) ≤
      (‖symbolDerivative f J.spatialOrder J.frequencyOrder x ξ‖ +
        ‖symbolDerivative g J.spatialOrder J.frequencyOrder x ξ‖) /
        (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ)) :=
      div_le_div_of_nonneg_right (norm_add_le _ _) (Real.rpow_nonneg (by positivity) _)
    _ = _ := add_div _ _ _
    _ ≤ symbolSeminormValue hU m J a + symbolSeminormValue hU m J b :=
      add_le_add
        (le_csSup (bddAbove_symbolSeminormValue_set hU m J a) ⟨x, hx, ξ, rfl⟩)
        (le_csSup (bddAbove_symbolSeminormValue_set hU m J b) ⟨x, hx, ξ, rfl⟩)

/-- The real derivatives remain homogeneous under complex scalar multiplication. -/
theorem symbolSeminormValue_smul (J : SymbolSeminormIndex U)
    (c : ℂ) (a : symbolSpace U hU m r q) :
    symbolSeminormValue hU m J (c • a) = ‖c‖ * symbolSeminormValue hU m J a := by
  /- Complex multiplication acts by a continuous real-linear map. Commute it
  with derivatives on U; the norm scales by norm(c). Take the bounded supremum,
  treating c=0 and the empty compact set explicitly. -/
  classical
  by_cases hK : J.compactSet.Nonempty
  swap
  · simp [symbolSeminormValue, Set.not_nonempty_iff_eq_empty.mp hK]
  obtain ⟨x₀, hx₀⟩ := hK
  let f := a.val
  have hparametric {P Q R : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [NormedAddCommGroup Q] [NormedSpace ℝ Q] [NormedAddCommGroup R] [NormedSpace ℝ R]
      (f : P → Q → R) (x : P) (y : Q)
      (hf : ContDiffAt ℝ ∞ (Function.uncurry f) (x, y)) (j : ℕ) :
      ContDiffAt ℝ ∞ (fun p : P × Q ↦ iteratedFDeriv ℝ j (f p.1) p.2) (x, y) := by
    -- Parameter differentiation remains smooth; each step differentiates and uncurries once.
    induction j with
    | zero =>
      exact hf.continuousLinearMap_comp
        ((continuousMultilinearCurryFin0 ℝ Q R).symm : _ →L[ℝ] Q [×0]→L[ℝ] R)
    | succ j ih =>
      have h : ContDiffAt ℝ ∞
          (Function.uncurry (fun p : P × Q ↦ fun z : Q ↦ iteratedFDeriv ℝ j (f p.1) z))
          ((x, y), y) := ih.comp ((x, y), y) (contDiffAt_fst.fst.prodMk contDiffAt_snd)
      have hd : ContDiffAt ℝ ∞
          (fun p : P × Q ↦ fderiv ℝ (iteratedFDeriv ℝ j (f p.1)) p.2) (x, y) :=
        h.fderiv contDiffAt_snd (by simp)
      exact hd.continuousLinearMap_comp
        ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (j + 1) ↦ Q) R).symm :
          _ →L[ℝ] Q [×(j + 1)]→L[ℝ] R)
  have hf (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ U)
      (ξ : EuclideanSpace ℝ (Fin n)) :
      ContDiffAt ℝ ∞ (Function.uncurry f) (x, ξ) :=
    a.property.1.contDiffAt ((hU.prod isOpen_univ).mem_nhds ⟨hx, Set.mem_univ ξ⟩)
  -- The complex scalar is constant, and hence acts real-linearly through both derivatives.
  have hder (i j : ℕ) (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ U)
      (ξ : EuclideanSpace ℝ (Fin n)) :
      symbolDerivative (c • f) i j x ξ = c • symbolDerivative f i j x ξ := by
    have hnear : (fun y ↦ iteratedFDeriv ℝ j ((c • f) y) ξ) =ᶠ[𝓝 x]
        (fun y ↦ c • iteratedFDeriv ℝ j (f y) ξ) := by
      filter_upwards [hU.mem_nhds hx] with y hy
      exact iteratedFDeriv_const_smul_apply (a := c)
        (((hf y hy ξ).comp ξ (contDiffAt_const.prodMk contDiffAt_id)).of_le (by simp))
    have hparam := (hparametric f x ξ (hf x hx ξ) j).comp x
      (contDiffAt_id.prodMk contDiffAt_const)
    exact ((hnear.iteratedFDeriv ℝ i).eq_of_nhds).trans
      (iteratedFDeriv_const_smul_apply (a := c) (hparam.of_le (by simp)))
  -- The nonnegative scalar norm carries the actual weighted-value set to its image.
  let S : Set ℝ := {t | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
    t = ‖symbolDerivative f J.spatialOrder J.frequencyOrder x ξ‖ /
      (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))}
  have hS : S.Nonempty := ⟨_, x₀, hx₀, 0, rfl⟩
  have hbound : BddAbove S := bddAbove_symbolSeminormValue_set hU m J a
  have himage : {t : ℝ | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
      t = ‖symbolDerivative (c • f) J.spatialOrder J.frequencyOrder x ξ‖ /
        (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))} =
        (fun t : ℝ ↦ ‖c‖ * t) '' S := by
    ext t
    constructor
    · rintro ⟨x, hx, ξ, rfl⟩
      refine ⟨_, ⟨x, hx, ξ, rfl⟩, ?_⟩
      rw [hder J.spatialOrder J.frequencyOrder x (J.subset_domain hx) ξ,
        norm_smul, mul_div_assoc]
    · rintro ⟨t, ⟨x, hx, ξ, rfl⟩, rfl⟩
      refine ⟨x, hx, ξ, ?_⟩
      rw [hder J.spatialOrder J.frequencyOrder x (J.subset_domain hx) ξ,
        norm_smul, mul_div_assoc]
  change sSup {t : ℝ | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
    t = ‖symbolDerivative (c • f) J.spatialOrder J.frequencyOrder x ξ‖ /
      (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))} = ‖c‖ * sSup S
  rw [himage]
  exact ((isLUB_csSup hS hbound).mul_left (norm_nonneg c)).csSup_eq (hS.image _)

/-- The standard complex seminorm associated with a compact set and two derivative orders. -/
def symbolSeminorm (J : SymbolSeminormIndex U) : Seminorm ℂ (symbolSpace U hU m r q) :=
  Seminorm.of (symbolSeminormValue hU m J)
    (symbolSeminormValue_add_le hU m J) (symbolSeminormValue_smul hU m J)

/-- Each measured derivative is controlled by the actual seminorm, without choosing a constant. -/
theorem symbolDerivative_norm_le_seminorm (J : SymbolSeminormIndex U)
    (a : symbolSpace U hU m r q) (x : EuclideanSpace ℝ (Fin n))
    (hx : x ∈ J.compactSet) (ξ : EuclideanSpace ℝ (Fin n)) :
    ‖symbolDerivative a.val J.spatialOrder J.frequencyOrder x ξ‖ ≤
      symbolSeminorm hU m J a * (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ)) := by
  /- The weighted derivative value belongs to the bounded set defining the
  supremum. Compare it with that supremum and multiply by the positive weight.
  The membership hx supplies nonemptiness even for zero-dimensional chart spaces. -/
  have hweight : 0 < (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ)) :=
    Real.rpow_pos_of_pos (by positivity) _
  -- This very derivative belongs to the defining set; multiply back its positive weight.
  apply (div_le_iff₀ hweight).mp
  exact le_csSup (bddAbove_symbolSeminormValue_set hU m J a) ⟨x, hx, ξ, rfl⟩

/-- These seminorms detect precisely vanishing over U, without inspecting values outside U. -/
theorem forall_symbolSeminorm_eq_zero_iff (a : symbolSpace U hU m r q) :
    (∀ J : SymbolSeminormIndex U, symbolSeminorm hU m J a = 0) ↔
      ∀ x ∈ U, ∀ ξ : EuclideanSpace ℝ (Fin n), a.val x ξ = 0 := by
  /- Forward: use the singleton compact set {x} and zero derivative orders.
  The preceding estimate makes every matrix norm zero. Reverse: vanishing on
  the open domain implies all mixed derivatives vanish there. Every defining
  supremum is then zero, also for the empty set. Values outside U are irrelevant. -/
  classical
  constructor
  · intro ha x hx ξ
    let J : SymbolSeminormIndex U :=
      { compactSet := {x}
        subset_domain := Set.singleton_subset_iff.mpr hx
        isCompact := isCompact_singleton
        spatialOrder := 0
        frequencyOrder := 0 }
    -- A singleton zero-order test controls the actual matrix value at this point.
    have hle := symbolDerivative_norm_le_seminorm hU m J a x (Set.mem_singleton x) ξ
    rw [ha J, zero_mul] at hle
    have hnorm : ‖a.val x ξ‖ ≤ 0 := by
      simpa only [symbolDerivative, J, norm_iteratedFDeriv_zero] using hle
    exact norm_le_zero_iff.mp hnorm
  · intro ha J
    -- Locality of the two derivatives ignores all arbitrary values outside U.
    have hderzero (i j : ℕ) (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ U)
        (ξ : EuclideanSpace ℝ (Fin n)) : symbolDerivative a.val i j x ξ = 0 := by
      have hnear : (fun y ↦ iteratedFDeriv ℝ j (a.val y) ξ) =ᶠ[𝓝 x] 0 := by
        filter_upwards [hU.mem_nhds hx] with y hy
        have hyzero : a.val y = 0 := funext (ha y hy)
        simp only [hyzero, iteratedFDeriv_zero, Pi.zero_apply]
      simpa only [symbolDerivative, iteratedFDeriv_zero, Pi.zero_apply] using
        (hnear.iteratedFDeriv ℝ i).eq_of_nhds
    change symbolSeminormValue hU m J a = 0
    by_cases hK : J.compactSet.Nonempty
    swap
    · simp [symbolSeminormValue, Set.not_nonempty_iff_eq_empty.mp hK]
    obtain ⟨x₀, hx₀⟩ := hK
    have hset : {t : ℝ | ∃ x ∈ J.compactSet, ∃ ξ : EuclideanSpace ℝ (Fin n),
        t = ‖symbolDerivative a.val J.spatialOrder J.frequencyOrder x ξ‖ /
          (1 + ‖ξ‖) ^ (m - (J.frequencyOrder : ℝ))} = {0} := by
      ext t
      constructor
      · rintro ⟨x, hx, ξ, rfl⟩
        rw [hderzero _ _ x (J.subset_domain hx) ξ]
        simp
      · intro ht
        refine ⟨x₀, hx₀, 0, ?_⟩
        rw [hderzero _ _ x₀ (J.subset_domain hx₀) 0, norm_zero, zero_div]
        exact Set.mem_singleton_iff.mp ht
    unfold symbolSeminormValue
    rw [hset]
    exact csSup_singleton 0

/-- The topology generated by weighted derivative seminorms on the existing symbol carrier. -/
@[instance_reducible]
def symbolTopology (r q : ℕ) : TopologicalSpace (symbolSpace U hU m r q) :=
  (SeminormFamily.moduleFilterBasis (symbolSeminorm (r := r) (q := q) hU m)).topology


attribute [local instance] symbolTopology

/-- The selected topology is generated by the displayed seminorm family. -/
theorem withSeminorms_symbolTopology :
    WithSeminorms (symbolSeminorm (r := r) (q := q) hU m) := by
  /- Unfold symbolTopology. The defining topological space is exactly the
  module filter basis constructed from these weighted derivative seminorms. -/
  -- The selected topology is exactly the module filter basis of this seminorm family.
  exact ⟨rfl⟩

/-- Convergence means uniform weighted control of every mixed derivative on each compact set. -/
theorem tendsto_symbolTopology_iff {Z : Type*} (l : Filter Z)
    (a : Z → symbolSpace U hU m r q) (b : symbolSpace U hU m r q) :
    Tendsto a l (𝓝 b) ↔ ∀ J : SymbolSeminormIndex U, ∀ ε : ℝ, 0 < ε →
      ∀ᶠ z in l, symbolSeminorm hU m J (a z - b) < ε := by
  /- Apply WithSeminorms.tendsto_nhds to the selected symbol topology.
  The seminorm is applied to a difference, so this is stronger than convergence
  of the individual nonnegative seminorm values and than pointwise convergence. -/
  -- The neighborhood criterion uses differences in the same actual symbol module.
  exact (withSeminorms_symbolTopology (r := r) (q := q) hU m).tendsto_nhds a b

end AtiyahSinger
