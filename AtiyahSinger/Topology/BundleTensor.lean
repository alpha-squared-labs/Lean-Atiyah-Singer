module

public import AtiyahSinger.Topology.FiniteBundle
public import Mathlib.LinearAlgebra.TensorProduct.Map

/-!
# Tensor products of actual finite continuous complex bundles

Public module ID: M1596.

D07/K01: the fibers are the algebraic complex tensor products of the original
fibers. The total topology is the final topology of all finite pure-tensor sums.
Each generating domain retains ONE common base point and has the topology induced
from the base and the original total spaces. It is not a coproduct of separate
fiber topologies.

Local finite linear charts identify this topology with the usual tensor-chart
topology: transition matrices are Kronecker products, with continuous entries.
The explicit tensor trivialization below records that identification on pure
vectors. Local ranks may vary, and no separation, compactness or metric is needed.

Source: Hatcher, Vector Bundles and K-Theory, version 2.2, pp.13--15, Tensor
Products. Hatcher describes the chart topology; the finite-sum final presentation
is the project's realization of that same topology. Page 15 explicitly extends
the construction from real to complex bundles. Mathlib supplies the algebraic
TensorProduct, map, and congr constructions, but no matching bundle topology.
-/

@[expose] public noncomputable section

namespace AtiyahSinger.ComplexBundle

open Bundle
open scoped TensorProduct

variable {X : Type*} [TopologicalSpace X]
  {E : X → Type*} [∀ x, AddCommGroup (E x)] [∀ x, Module ℂ (E x)]
  [TopologicalSpace (TotalSpace Unit E)]
  {F : X → Type*} [∀ x, AddCommGroup (F x)] [∀ x, Module ℂ (F x)]
  [TopologicalSpace (TotalSpace Unit F)]

/-- The tensor total topology, generated by finite tensor sums at one common base point. -/
@[instance_reducible]
def tensorTopology : TopologicalSpace (TotalSpace Unit (fun x ↦ E x ⊗[ℂ] F x)) :=
  ⨆ m : ℕ,
    let D := TotalSpace Unit (fun x ↦ (Fin m → E x) × (Fin m → F x))
    letI : TopologicalSpace D := TopologicalSpace.induced
      (fun z : D ↦ (z.proj,
        (fun i : Fin m ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
        (fun i : Fin m ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit F)))) inferInstance
    TopologicalSpace.coinduced
      (fun z : D ↦ (⟨z.proj, ∑ i : Fin m, z.snd.1 i ⊗ₜ[ℂ] z.snd.2 i⟩ :
        TotalSpace Unit (fun x ↦ E x ⊗[ℂ] F x))) inferInstance

attribute [local instance] tensorTopology

set_option maxHeartbeats 800000 in

/-- Local tensor coordinates are the products of the two given linear coordinates. -/
theorem exists_tensor_trivialization {r s : ℕ}
    (e : Trivialization (Fin r → ℂ) (π Unit E))
    (f : Trivialization (Fin s → ℂ) (π Unit F))
    (he : ∀ x ∈ e.baseSet, IsLinearMap ℂ (fun v : E x ↦ (e ⟨x, v⟩).2))
    (hf : ∀ x ∈ f.baseSet, IsLinearMap ℂ (fun v : F x ↦ (f ⟨x, v⟩).2)) :
    ∃ t : Trivialization (Fin (r * s) → ℂ) (π Unit (fun x ↦ E x ⊗[ℂ] F x)),
      t.baseSet = e.baseSet ∩ f.baseSet ∧
      (∀ x ∈ t.baseSet,
        IsLinearMap ℂ (fun v : E x ⊗[ℂ] F x ↦ (t ⟨x, v⟩).2)) ∧
      ∀ (x : X), x ∈ e.baseSet ∩ f.baseSet →
        ∀ (v : E x) (w : F x) (i : Fin r) (j : Fin s),
          (t ⟨x, v ⊗ₜ[ℂ] w⟩).2 (finProdFinEquiv (i, j)) =
            (e ⟨x, v⟩).2 i * (f ⟨x, w⟩).2 j := by
  /- Stage 1: on the intersection, the given linear trivializations identify
  each fiber with its coordinate space. Tensor these fiber equivalences and
  identify the product-indexed basis with Fin(r*s) using finProdFinEquiv.
  Stage 2: each finite-sum generator is continuous in these tensor coordinates:
  its entries are finite sums of products of the original continuous coordinates.
  Conversely, a coordinate tensor has a continuous finite-sum lift, by expanding
  in the fixed tensor basis and putting its coefficients into one factor.
  Thus the final topology agrees with this product chart topology locally.
  The same generator test makes projection to X continuous, so the preimage of
  the intersection is open. The coordinate equivalence is a bundle trivialization.
  Stage 3: the algebraic tensor-basis computation gives the displayed pure-vector
  formula and fiberwise linearity. Zero ranks use the zero coordinate space and
  the m=0 generator, which retains the genuine base topology. No global charts,
  fiber topology choices, or continuity of a chosen varying basis are assumed. -/
  classical
  -- Keep the inverse fiber vectors of the two specified charts, including their base casts.
  let eLin (x : X) (hx : x ∈ e.baseSet) : E x ≃ₗ[ℂ] (Fin r → ℂ) :=
    { toFun := fun v ↦ (e ⟨x, v⟩).2
      invFun := fun v ↦ cast (congrArg E (e.proj_symm_apply' hx))
        (e.toOpenPartialHomeomorph.symm (x, v)).snd
      left_inv := by
        intro v
        rw [cast_eq_iff_heq]
        exact congr_arg_heq (fun z : TotalSpace Unit E ↦ z.snd)
          (e.symm_apply_mk_proj (x := ⟨x, v⟩) (e.mem_source.mpr hx))
      right_inv := by
        intro v
        have hp := TotalSpace.mk_cast (F := Unit) (E := E)
          (e.proj_symm_apply' (x := v) hx) (e.toOpenPartialHomeomorph.symm (x, v)).snd
        exact (congrArg (fun z : TotalSpace Unit E ↦ (e z).2) hp).trans
          (congrArg Prod.snd (e.apply_symm_apply' hx))
      map_add' := (he x hx).map_add
      map_smul' := (he x hx).map_smul }
  let fLin (x : X) (hx : x ∈ f.baseSet) : F x ≃ₗ[ℂ] (Fin s → ℂ) :=
    { toFun := fun v ↦ (f ⟨x, v⟩).2
      invFun := fun v ↦ cast (congrArg F (f.proj_symm_apply' hx))
        (f.toOpenPartialHomeomorph.symm (x, v)).snd
      left_inv := by
        intro v
        rw [cast_eq_iff_heq]
        exact congr_arg_heq (fun z : TotalSpace Unit F ↦ z.snd)
          (f.symm_apply_mk_proj (x := ⟨x, v⟩) (f.mem_source.mpr hx))
      right_inv := by
        intro v
        have hp := TotalSpace.mk_cast (F := Unit) (E := F)
          (f.proj_symm_apply' (x := v) hx) (f.toOpenPartialHomeomorph.symm (x, v)).snd
        exact (congrArg (fun z : TotalSpace Unit F ↦ (f z).2) hp).trans
          (congrArg Prod.snd (f.apply_symm_apply' hx))
      map_add' := (hf x hx).map_add
      map_smul' := (hf x hx).map_smul }
  have hpointE (x : X) (hx : x ∈ e.baseSet) (v : Fin r → ℂ) :
      (⟨x, (eLin x hx).symm v⟩ : TotalSpace Unit E) =
        e.toOpenPartialHomeomorph.symm (x, v) :=
    TotalSpace.mk_cast (F := Unit) (E := E) (e.proj_symm_apply' hx) _
  have hpointF (x : X) (hx : x ∈ f.baseSet) (v : Fin s → ℂ) :
      (⟨x, (fLin x hx).symm v⟩ : TotalSpace Unit F) =
        f.toOpenPartialHomeomorph.symm (x, v) :=
    TotalSpace.mk_cast (F := Unit) (E := F) (f.proj_symm_apply' hx) _
  let U : Set X := e.baseSet ∩ f.baseSet
  have hU : IsOpen U := e.open_baseSet.inter f.open_baseSet
  let bp : Module.Basis (Fin r) ℂ (Fin r → ℂ) := Pi.basisFun ℂ (Fin r)
  let bq : Module.Basis (Fin s) ℂ (Fin s → ℂ) := Pi.basisFun ℂ (Fin s)
  let b : Module.Basis (Fin (r * s)) ℂ ((Fin r → ℂ) ⊗[ℂ] (Fin s → ℂ)) :=
    (bp.tensorProduct bq).reindex finProdFinEquiv
  let c (x : X) (hx : x ∈ U) : (E x ⊗[ℂ] F x) ≃ₗ[ℂ] (Fin (r * s) → ℂ) :=
    (TensorProduct.congr (eLin x hx.1) (fLin x hx.2)).trans b.equivFun
  have hpure (x : X) (hx : x ∈ U) (v : E x) (w : F x) (k : Fin (r * s)) :
      c x hx (v ⊗ₜ[ℂ] w) k =
        (e ⟨x, v⟩).2 (finProdFinEquiv.symm k).1 *
          (f ⟨x, w⟩).2 (finProdFinEquiv.symm k).2 := by
    change (b.repr ((eLin x hx.1) v ⊗ₜ[ℂ] (fLin x hx.2) w)) k = _
    rw [Module.Basis.repr_reindex_apply]
    calc
      _ = (fLin x hx.2 w) (finProdFinEquiv.symm k).2 *
          (eLin x hx.1 v) (finProdFinEquiv.symm k).1 :=
        bp.tensorProduct_repr_tmul_apply bq _ _ _ _
      _ = _ := mul_comm _ _
  let T := TotalSpace Unit (fun x ↦ E x ⊗[ℂ] F x)
  let D (m : ℕ) := TotalSpace Unit (fun x ↦ (Fin m → E x) × (Fin m → F x))
  let instD (m : ℕ) : TopologicalSpace (D m) := TopologicalSpace.induced
    (fun z : D m ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit F)))) inferInstance
  let generator (m : ℕ) (z : D m) : T :=
    ⟨z.proj, ∑ i, z.snd.1 i ⊗ₜ[ℂ] z.snd.2 i⟩
  have hgenerator (m : ℕ) : Continuous (generator m) :=
    continuous_iSup_rng (i := m) continuous_coinduced_rng
  have hcoords (m : ℕ) : Continuous (fun z : D m ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit F)))) := continuous_induced_dom
  -- The explicit base coordinate in every generator also handles the zero-rank case.
  have hbase : Continuous (π Unit (fun x ↦ E x ⊗[ℂ] F x)) := by
    apply continuous_iSup_dom.mpr
    intro m
    apply continuous_coinduced_dom.mpr
    exact (hcoords m).fst
  let forward (z : T) : X × (Fin (r * s) → ℂ) :=
    (z.proj, if hx : z.proj ∈ U then c z.proj hx z.snd else 0)
  let inverse (y : X × (Fin (r * s) → ℂ)) : T :=
    ⟨y.1, if hx : y.1 ∈ U then (c y.1 hx).symm y.2 else 0⟩
  have hopen : IsOpen ((π Unit (fun x ↦ E x ⊗[ℂ] F x)) ⁻¹' U) := hU.preimage hbase
  -- In every generating family the coordinates are finite sums of products.
  have hforward : ContinuousOn forward ((π Unit (fun x ↦ E x ⊗[ℂ] F x)) ⁻¹' U) := by
    apply (continuousOn_open_iff hopen).mpr
    intro W hW
    apply isOpen_iSup_iff.mpr
    intro m
    apply isOpen_coinduced.mpr
    have hlocal : ContinuousOn (forward ∘ generator m) {z : D m | z.proj ∈ U} := by
      have hentries (i : Fin m) (k : Fin (r * s)) :
          ContinuousOn (fun z : D m ↦
            (e ⟨z.proj, z.snd.1 i⟩).2 (finProdFinEquiv.symm k).1 *
              (f ⟨z.proj, z.snd.2 i⟩).2 (finProdFinEquiv.symm k).2)
            {z : D m | z.proj ∈ U} := by
        have hE : ContinuousOn (fun z : D m ↦ e ⟨z.proj, z.snd.1 i⟩)
            {z : D m | z.proj ∈ U} := e.toOpenPartialHomeomorph.continuousOn.comp
          (((continuous_apply i).comp (hcoords m).snd.fst).continuousOn)
          (fun z hz ↦ e.mem_source.mpr hz.1)
        have hF : ContinuousOn (fun z : D m ↦ f ⟨z.proj, z.snd.2 i⟩)
            {z : D m | z.proj ∈ U} := f.toOpenPartialHomeomorph.continuousOn.comp
          (((continuous_apply i).comp (hcoords m).snd.snd).continuousOn)
          (fun z hz ↦ f.mem_source.mpr hz.2)
        exact ((continuous_apply _).comp_continuousOn hE.snd).mul
          ((continuous_apply _).comp_continuousOn hF.snd)
      have hsum : ContinuousOn (fun z : D m ↦ (z.proj,
          fun k : Fin (r * s) ↦ ∑ i : Fin m,
            (e ⟨z.proj, z.snd.1 i⟩).2 (finProdFinEquiv.symm k).1 *
              (f ⟨z.proj, z.snd.2 i⟩).2 (finProdFinEquiv.symm k).2))
          {z : D m | z.proj ∈ U} := (hcoords m).fst.continuousOn.prodMk
        (continuousOn_pi.mpr (fun k ↦ continuousOn_finsetSum Finset.univ
          (fun i _ ↦ hentries i k)))
      refine hsum.congr ?_
      intro z hz
      change z.proj ∈ U at hz
      apply Prod.ext
      · rfl
      · funext k
        change (if hx : z.proj ∈ U then
          c z.proj hx (∑ i : Fin m, z.snd.1 i ⊗ₜ[ℂ] z.snd.2 i) else 0) k = _
        rw [dite_eq_left hz, map_sum, Finset.sum_apply]
        exact Finset.sum_congr rfl (fun i _ ↦ hpure z.proj hz _ _ k)
    exact hlocal.isOpen_inter_preimage (hU.preimage (hcoords m).fst) hW
  -- A tensor-coordinate vector lifts continuously to one fixed finite-sum generator.
  let lift (y : X × (Fin (r * s) → ℂ)) : D (r * s) :=
    ⟨y.1,
      (fun k ↦ if hx : y.1 ∈ U then
        (eLin y.1 hx.1).symm (y.2 k • bp (finProdFinEquiv.symm k).1) else 0),
      (fun k ↦ if hx : y.1 ∈ U then
        (fLin y.1 hx.2).symm (bq (finProdFinEquiv.symm k).2) else 0)⟩
  have hlift : ContinuousOn lift (U ×ˢ Set.univ) := by
    let hind : Topology.IsInducing (fun z : D (r * s) ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit F)))) := ⟨rfl⟩
    rw [hind.continuousOn_iff]
    refine continuous_fst.continuousOn.prodMk ((continuousOn_pi.mpr ?_).prodMk
      (continuousOn_pi.mpr ?_))
    · intro k
      have harg : Continuous (fun y : X × (Fin (r * s) → ℂ) ↦
          (y.1, y.2 k • bp (finProdFinEquiv.symm k).1)) :=
        continuous_fst.prodMk (((continuous_apply k).comp continuous_snd).smul
          continuous_const)
      refine (e.toOpenPartialHomeomorph.continuousOn_symm.comp harg.continuousOn
        (fun y hy ↦ e.mem_target.mpr hy.1.1)).congr ?_
      intro y hy
      change (⟨y.1, if hx : y.1 ∈ U then _ else 0⟩ : TotalSpace Unit E) = _
      rw [dite_eq_left hy.1]
      exact hpointE y.1 hy.1.1 _
    · intro k
      have harg : Continuous (fun y : X × (Fin (r * s) → ℂ) ↦
          (y.1, bq (finProdFinEquiv.symm k).2)) := continuous_fst.prodMk continuous_const
      refine (f.toOpenPartialHomeomorph.continuousOn_symm.comp harg.continuousOn
        (fun y hy ↦ f.mem_target.mpr hy.1.2)).congr ?_
      intro y hy
      change (⟨y.1, if hx : y.1 ∈ U then _ else 0⟩ : TotalSpace Unit F) = _
      rw [dite_eq_left hy.1]
      exact hpointF y.1 hy.1.2 _
  have hinverse : ContinuousOn inverse (U ×ˢ Set.univ) := by
    refine ((hgenerator (r * s)).comp_continuousOn hlift).congr ?_
    intro y hy
    change (⟨y.1, if hx : y.1 ∈ U then (c y.1 hx).symm y.2 else 0⟩ : T) = _
    rw [dite_eq_left hy.1]
    apply congrArg (TotalSpace.mk y.1)
    change (c y.1 hy.1).symm y.2 = ∑ k,
      (if hx : y.1 ∈ U then _ else 0) ⊗ₜ[ℂ] (if hx : y.1 ∈ U then _ else 0)
    simp only [dite_eq_left hy.1, c, LinearEquiv.trans_symm, LinearEquiv.trans_apply,
      Module.Basis.equivFun_symm_apply, map_sum, map_smul]
    apply Finset.sum_congr rfl
    intro k _
    simp only [b, Module.Basis.reindex_apply, Module.Basis.tensorProduct_apply',
      TensorProduct.congr_symm, TensorProduct.congr_tmul,
      TensorProduct.smul_tmul']
  let t : Trivialization (Fin (r * s) → ℂ) (π Unit (fun x ↦ E x ⊗[ℂ] F x)) :=
    { toFun := forward
      invFun := inverse
      source := (π Unit (fun x ↦ E x ⊗[ℂ] F x)) ⁻¹' U
      target := U ×ˢ Set.univ
      baseSet := U
      map_source' := fun _ h ↦ ⟨h, Set.mem_univ _⟩
      map_target' := fun _ h ↦ h.1
      left_inv' := by
        intro z hz
        change z.proj ∈ U at hz
        simp only [forward, inverse, dite_eq_left hz, LinearEquiv.symm_apply_apply]
      right_inv' := by
        intro y hy
        simp only [forward, inverse, dite_eq_left hy.1, LinearEquiv.apply_symm_apply]
      open_source := hopen
      open_target := hU.prod isOpen_univ
      continuousOn_toFun := hforward
      continuousOn_invFun := hinverse
      source_eq := rfl
      target_eq := rfl
      open_baseSet := hU
      proj_toFun := fun _ _ ↦ rfl }
  refine ⟨t, rfl, ?_, ?_⟩
  · intro x hx
    change x ∈ U at hx
    constructor
    · intro v w
      change (if h : x ∈ U then c x h (v + w) else 0) =
        (if h : x ∈ U then c x h v else 0) + (if h : x ∈ U then c x h w else 0)
      simp only [dite_eq_left hx, map_add]
    · intro a v
      change (if h : x ∈ U then c x h (a • v) else 0) =
        a • (if h : x ∈ U then c x h v else 0)
      simp only [dite_eq_left hx, map_smul]
  · intro x hx v w i j
    change x ∈ U at hx
    change (if h : x ∈ U then c x h (v ⊗ₜ[ℂ] w) else 0) (finProdFinEquiv (i, j)) = _
    rw [dite_eq_left hx]
    simpa only [Equiv.symm_apply_apply] using hpure x hx v w (finProdFinEquiv (i, j))

/-- Tensor product preserves local finite linear triviality, allowing varying ranks. -/
theorem isFiniteRank_tensor [IsFiniteRank E] [IsFiniteRank F] :
    IsFiniteRank (fun x ↦ E x ⊗[ℂ] F x) := by
  /- At each base point choose one finite linear chart of each original bundle.
  Apply exists_tensor_trivialization on their intersection. It contains the
  point and supplies exactly the finite linear chart required by IsFiniteRank.
  Its rank is the product of the two local ranks, with no global bound needed. -/
  constructor
  intro x
  obtain ⟨r, e, hx, he⟩ := IsFiniteRank.exists_linear_trivialization (E := E) x
  obtain ⟨s, f, hy, hf⟩ := IsFiniteRank.exists_linear_trivialization (E := F) x
  obtain ⟨t, hbase, hlinear, _⟩ := exists_tensor_trivialization e f he hf
  refine ⟨r * s, t, ?_, hlinear⟩
  rw [hbase]
  exact ⟨hx, hy⟩

attribute [local instance] isFiniteRank_tensor

/-- Bundle tensor product packages the original tensor fibers and the final total topology. -/
@[reducible]
def FiniteBundle.tensor (E F : FiniteBundle X) : FiniteBundle X where
  Fiber := fun x ↦ E.Fiber x ⊗[ℂ] F.Fiber x

variable {G : X → Type*} [∀ x, AddCommGroup (G x)] [∀ x, Module ℂ (G x)]
  [TopologicalSpace (TotalSpace Unit G)]
  {H : X → Type*} [∀ x, AddCommGroup (H x)] [∀ x, Module ℂ (H x)]
  [TopologicalSpace (TotalSpace Unit H)]

/-- Tensoring continuous fiber maps preserves continuity for the actual final topologies. -/
theorem Hom.continuous_tensor (a : Hom E F) (b : Hom G H) :
    Continuous (fun z : TotalSpace Unit (fun x ↦ E x ⊗[ℂ] G x) ↦
      (⟨z.proj, TensorProduct.map (a.linearMap z.proj) (b.linearMap z.proj) z.snd⟩ :
        TotalSpace Unit (fun x ↦ F x ⊗[ℂ] H x))) := by
  /- Stage 1: test continuity against every finite-sum generator of the source
  final topology. Apply a and b to the respective vectors, retaining their common
  base point. This tuple map is continuous for the induced domain topologies,
  since each original total map is continuous and the base coordinate is unchanged.
  Stage 2: the tensor map carries the input sum to the sum of the mapped pure
  tensors. It therefore factors through the corresponding target generator.
  This proves continuity by the final-topology universal property, without
  requiring local finite rank for this functoriality argument. -/
  -- Test the original final topology one finite-sum generator at a time.
  apply continuous_iSup_dom.mpr
  intro m
  apply continuous_coinduced_dom.mpr
  let D := TotalSpace Unit (fun x ↦ (Fin m → E x) × (Fin m → G x))
  let D' := TotalSpace Unit (fun x ↦ (Fin m → F x) × (Fin m → H x))
  let : TopologicalSpace D := TopologicalSpace.induced
    (fun z : D ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit G)))) inferInstance
  let : TopologicalSpace D' := TopologicalSpace.induced
    (fun z : D' ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit F)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit H)))) inferInstance
  let mapTuple (z : D) : D' :=
    ⟨z.proj, (fun i ↦ a.linearMap z.proj (z.snd.1 i)),
      (fun i ↦ b.linearMap z.proj (z.snd.2 i))⟩
  have hcoords : Continuous (fun z : D ↦ (z.proj,
      (fun i ↦ (⟨z.proj, z.snd.1 i⟩ : TotalSpace Unit E)),
      (fun i ↦ (⟨z.proj, z.snd.2 i⟩ : TotalSpace Unit G)))) := continuous_induced_dom
  have hmap : Continuous mapTuple := by
    apply continuous_induced_rng.mpr
    exact hcoords.fst.prodMk ((continuous_pi fun i ↦
      a.continuous_total.comp ((continuous_apply i).comp hcoords.snd.fst)).prodMk
        (continuous_pi fun i ↦
          b.continuous_total.comp ((continuous_apply i).comp hcoords.snd.snd)))
  have hgenerator : Continuous (fun z : D' ↦
      (⟨z.proj, ∑ i, z.snd.1 i ⊗ₜ[ℂ] z.snd.2 i⟩ :
        TotalSpace Unit (fun x ↦ F x ⊗[ℂ] H x))) :=
    continuous_iSup_rng (i := m) continuous_coinduced_rng
  -- The actual tensor map sends each pure summand to the two original mapped vectors.
  refine (hgenerator.comp hmap).congr ?_
  intro z
  simp only [Function.comp_apply, mapTuple, map_sum, TensorProduct.map_tmul]

/-- Tensor product of actual bundle maps over a common base. -/
def Hom.tensor (a : Hom E F) (b : Hom G H) :
    Hom (fun x ↦ E x ⊗[ℂ] G x) (fun x ↦ F x ⊗[ℂ] H x) where
  linearMap x := TensorProduct.map (a.linearMap x) (b.linearMap x)
  continuous_total := a.continuous_tensor b

/-- Tensor product of actual bundle isomorphisms retains the specified fiber equivalences. -/
def Iso.tensor (a : Iso E F) (b : Iso G H) :
    Iso (fun x ↦ E x ⊗[ℂ] G x) (fun x ↦ F x ⊗[ℂ] H x) where
  linearEquiv x := TensorProduct.congr (a.linearEquiv x) (b.linearEquiv x)
  continuous_total := a.toHom.continuous_tensor b.toHom
  continuous_symm := a.symm.toHom.continuous_tensor b.symm.toHom

end AtiyahSinger.ComplexBundle
