module

public import AtiyahSinger.Topology.CompactDualityNaturality
public import AtiyahSinger.Topology.CompactPoincareDuality
public import Mathlib.AlgebraicTopology.SingularHomology.HomologyZero

/-!
# Top-degree compact-support classes are generated locally

Public module ID: M1669.

Poincare duality identifies top-degree compact-support cohomology with ordinary
zero-dimensional homology. Every zero-simplex lies in one member of any open
cover. Naturality of the same duality map therefore shows that a linear functional
is determined by its values on extension from the members of that cover.

This supplies the local-to-global uniqueness used for normalized Thom integration;
it makes no assertion that local agreement determines arbitrary higher-degree maps.
Source: the degree-zero case of singular homology and naturality of Poincare duality.
-/

@[expose] public noncomputable section

namespace AtiyahSinger

open CategoryTheory Limits Opposite TopologicalSpace Topology
open scoped Simplicial

variable {n : ℕ} {M : Type} [TopologicalSpace M]
  [ChartedSpace (EuclideanSpace ℝ (Fin n)) M]
  [T2Space M]

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- Top-degree functionals agree if they agree after extension from every member
of an open cover. -/
theorem compactSupportCohomology_top_ext_of_openCover [SecondCountableTopology M]
    (O : HomologicalOrientation n M) {ι : Type} (U : ι → Opens M)
    (hcover : ∀ x : M, ∃ i, x ∈ U i)
    (f g : compactSupportCohomology ℚ M n →ₗ[ℚ] ℚ)
    (hfg : ∀ (i : ι) (a : compactSupportCohomology ℚ (U i) n),
      f (compactSupportCohomologyOpenExtension ℚ
        (ContinuousMap.subtypeVal (U i : Set M)) (U i).isOpen.isOpenEmbedding_subtypeVal n a) =
      g (compactSupportCohomologyOpenExtension ℚ
        (ContinuousMap.subtypeVal (U i : Set M)) (U i).isOpen.isOpenEmbedding_subtypeVal n a)) :
    f = g := by
  let : LocallyCompactSpace M := ChartedSpace.locallyCompactSpace
    (EuclideanSpace ℝ (Fin n)) M
  let e := compactPoincareDualityEquiv O n 0 (Nat.add_zero n)
  let F : singularHomology ℚ M 0 ⟶ ModuleCat.of ℚ ℚ :=
    ModuleCat.ofHom (f.comp e.symm.toLinearMap)
  let G : singularHomology ℚ M 0 ⟶ ModuleCat.of ℚ ℚ :=
    ModuleCat.ofHom (g.comp e.symm.toLinearMap)
  -- The duality square transports the given local agreement to ordinary zero-homology.
  have hopen (i : ι) : singularHomologyMap ℚ (ContinuousMap.subtypeVal (U i : Set M)) 0 ≫ F =
      singularHomologyMap ℚ (ContinuousMap.subtypeVal (U i : Set M)) 0 ≫ G := by
    let j := ContinuousMap.subtypeVal (U i : Set M)
    have hj : IsOpenEmbedding j := (U i).isOpen.isOpenEmbedding_subtypeVal
    let P : HomologicalOrientation n (U i) := homologicalOrientationOpenPullback O j hj
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    obtain ⟨a, rfl⟩ :=
      (compactPoincareDuality_bijective (M := U i) P n 0 (Nat.add_zero n)).surjective z
    change f (e.symm (singularHomologyMap ℚ j 0
        (compactPoincareDuality P n 0 (Nat.add_zero n) a))) =
      g (e.symm (singularHomologyMap ℚ j 0
        (compactPoincareDuality P n 0 (Nat.add_zero n) a)))
    have hnat := compactPoincareDuality_openExtension (X := U i) (Y := M) P O j hj
      (homologicalOrientationOpenPullback_orientationPreserving O j hj) n 0 (Nat.add_zero n) a
    have heq : e.symm (singularHomologyMap ℚ j 0
        (compactPoincareDuality P n 0 (Nat.add_zero n) a)) =
        compactSupportCohomologyOpenExtension ℚ j hj n a := by
      calc
        _ = e.symm (e (compactSupportCohomologyOpenExtension ℚ j hj n a)) :=
          congrArg e.symm hnat.symm
        _ = _ := e.symm_apply_apply _
    exact (congrArg f heq).trans ((hfg i a).trans (congrArg g heq).symm)
  have hFG : F = G := by
    let C := singularChains ℚ M
    let S := TopCat.toSSet.obj (TopCat.of M)
    let : IsIso (C.iCycles 0) := ChainComplex.isIso_iCycles₀ C
    -- The quotient of zero-chains is surjective, and the chain module is generated by simplices.
    apply (cancel_epi (C.homologyπ 0)).mp
    apply (cancel_epi (inv (C.iCycles 0))).mp
    apply Sigma.hom_ext
    intro σ
    let v : SimplexCategory.toTop.obj ⦋0⦌ := default
    obtain ⟨i, hi⟩ := hcover (σ.down.hom v)
    let j := ContinuousMap.subtypeVal (U i : Set M)
    let Si := TopCat.toSSet.obj (TopCat.of (U i))
    let Ci := singularChains ℚ (U i)
    have hmem (t : SimplexCategory.toTop.obj ⦋0⦌) : σ.down.hom t ∈ U i := by
      simpa only [Subsingleton.elim t v] using hi
    let τ : Si.obj (op ⦋0⦌) :=
      ⟨TopCat.ofHom ⟨fun t ↦ ⟨σ.down.hom t, hmem t⟩,
        σ.down.hom.continuous.subtype_mk hmem⟩⟩
    have hσ : (TopCat.toSSet.map (TopCat.ofHom j)).app (op ⦋0⦌) τ = σ := by
      apply ULift.ext
      apply TopCat.hom_ext
      apply ContinuousMap.ext
      intro t
      rfl
    let : IsIso (Ci.iCycles 0) := ChainComplex.isIso_iCycles₀ Ci
    have hlift : S.ιChainComplex (R := singularCoefficient.{0} ℚ) σ ≫ inv (C.iCycles 0) =
        C.liftCycles (S.ιChainComplex (R := singularCoefficient.{0} ℚ) σ) 0
          (by simp) (by simp) := by
      apply (cancel_mono (C.iCycles 0)).mp
      simp
    have hlifti : Si.ιChainComplex (R := singularCoefficient.{0} ℚ) τ ≫ inv (Ci.iCycles 0) =
        Ci.liftCycles (Si.ιChainComplex (R := singularCoefficient.{0} ℚ) τ) 0
          (by simp) (by simp) := by
      apply (cancel_mono (Ci.iCycles 0)).mp
      simp
    have hfac : Si.ιChainComplex (R := singularCoefficient.{0} ℚ) τ ≫ inv (Ci.iCycles 0) ≫
        Ci.homologyπ 0 ≫ singularHomologyMap ℚ j 0 =
        S.ιChainComplex (R := singularCoefficient.{0} ℚ) σ ≫ inv (C.iCycles 0) ≫
          C.homologyπ 0 := by
      simp only [← Category.assoc, hlift, hlifti]
      simp only [Category.assoc]
      erw [HomologicalComplex.homologyπ_naturality,
        HomologicalComplex.liftCycles_comp_cyclesMap_assoc, SSet.ι_chainComplexMap_f]
      congr 2
    change S.ιChainComplex (R := singularCoefficient.{0} ℚ) σ ≫ inv (C.iCycles 0) ≫
      C.homologyπ 0 ≫ F =
      S.ιChainComplex (R := singularCoefficient.{0} ℚ) σ ≫ inv (C.iCycles 0) ≫
        C.homologyπ 0 ≫ G
    calc
      _ = (Si.ιChainComplex (R := singularCoefficient.{0} ℚ) τ ≫ inv (Ci.iCycles 0) ≫
          Ci.homologyπ 0 ≫ singularHomologyMap ℚ j 0) ≫ F := by rw [hfac]; simp
      _ = (Si.ιChainComplex (R := singularCoefficient.{0} ℚ) τ ≫ inv (Ci.iCycles 0) ≫
          Ci.homologyπ 0 ≫ singularHomologyMap ℚ j 0) ≫ G := by
        simp only [Category.assoc]
        rw [hopen i]
      _ = _ := by rw [hfac]; simp
  -- The actual inverse duality identifies every original compact-support class.
  apply LinearMap.ext
  intro a
  have h := congrArg (fun k ↦ k (e a)) hFG
  change f (e.symm (e a)) = g (e.symm (e a)) at h
  simpa only [e.symm_apply_apply] using h

end AtiyahSinger
