module

public import AtiyahSinger.Algebra.ExteriorParity
public import AtiyahSinger.Topology.FiniteBundle
public import Mathlib.LinearAlgebra.ExteriorAlgebra.Basis

/-!
# Exterior algebras and parity subbundles

Public module ID: M1839.

The construction uses the actual fibers `ExteriorAlgebra ℂ (E x)`. Their total topology is the
final topology generated by finite sums of wedge monomials, all over one common
base point. The generating domains retain the original total-space topology of E,
the base point, and the scalar coefficients. Degree-zero monomials and the empty
sum are included, so neither the scalar summand nor the base topology is lost.

The local coordinate theorem identifies this explicit topology with the usual
exterior-power chart topology. The even and odd parts are mathlib's literal
`CliffordAlgebra.evenOdd` submodules at the zero quadratic form, given the topology
induced by their inclusion in the exterior total space. Local ranks may vary.
Rank zero has even rank one and odd rank zero; no equal-rank assumption is made.

Sources: Spin Geometry, Appendix C, especially Theorem C.8; Karoubi, K-Theory,
IV.1.4--1.6. The finite-wedge-sum presentation is the project's realization of
the standard chart topology. No pointwise choice of a fiber norm is used to
define the total topology, and no topology is selected from an omitted proof.
-/

@[expose] public noncomputable section

namespace AtiyahSinger.ComplexBundle

open Bundle

variable {X : Type*} [TopologicalSpace X]
  {E : X → Type*} [∀ x, AddCommGroup (E x)] [∀ x, Module ℂ (E x)]
  [TopologicalSpace (TotalSpace Unit E)]

/-- The exterior total topology generated by finite wedge sums at a common base point. -/
@[instance_reducible]
def exteriorTopology : TopologicalSpace (TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x))) :=
  ⨆ m : ℕ, ⨆ k : Fin m → ℕ,
    let D := TotalSpace Unit
      (fun x ↦ (Fin m → ℂ) × (∀ i : Fin m, Fin (k i) → E x))
    letI : TopologicalSpace D := TopologicalSpace.induced
      (fun z : D ↦ (z.proj, z.snd.1,
        (fun (i : Fin m) (j : Fin (k i)) ↦
          (⟨z.proj, z.snd.2 i j⟩ : TotalSpace Unit E)))) inferInstance
    TopologicalSpace.coinduced
      (fun z : D ↦ (⟨z.proj,
        ∑ i : Fin m, z.snd.1 i • ExteriorAlgebra.ιMulti ℂ (k i) (z.snd.2 i)⟩ :
          TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x)))) inferInstance

attribute [local instance] exteriorTopology

/-- The standard parity subbundle has the topology induced by its actual inclusion. -/
@[instance_reducible]
def exteriorParityTopology (i : ZMod 2) :
    TopologicalSpace (TotalSpace Unit
      (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i)) :=
  TopologicalSpace.induced
    (fun z : TotalSpace Unit
        (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i) ↦
      (⟨z.proj, z.snd.val⟩ : TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x))))
    inferInstance

attribute [local instance] exteriorParityTopology

/-- Exterior coordinates are the exterior-algebra map of the original linear chart. -/
theorem exists_exterior_trivialization {r : ℕ}
    (e : Trivialization (Fin r → ℂ) (π Unit E))
    (he : ∀ x ∈ e.baseSet, IsLinearMap ℂ (fun v : E x ↦ (e ⟨x, v⟩).2)) :
    ∃ t : Trivialization (Fin (Fintype.card (Finset (Fin r))) → ℂ)
        (π Unit (fun x ↦ ExteriorAlgebra ℂ (E x))),
      t.baseSet = e.baseSet ∧
      (∀ x ∈ t.baseSet,
        IsLinearMap ℂ (fun a : ExteriorAlgebra ℂ (E x) ↦ (t ⟨x, a⟩).2)) ∧
      ∀ (x : X) (hx : x ∈ e.baseSet) (a : ExteriorAlgebra ℂ (E x)),
        (t ⟨x, a⟩).2 =
          (((Pi.basisFun ℂ (Fin r)).ExteriorAlgebra.reindex
            (Fintype.equivFin (Finset (Fin r)))).equivFun)
              (ExteriorAlgebra.map (IsLinearMap.mk' _ (he x hx)) a) := by
  /- Stage 1: the original chart gives a linear equivalence on each fiber over
  its base set. Apply the exterior-algebra functor, then take coordinates in the
  fixed exterior basis of the coordinate space. Reindex its finite-subset index
  set by Fin(card); its cardinality is 2^r, including the empty subset.
  Stage 2: in these coordinates every generating wedge sum has entries that are
  finite sums of scalar multiples of minors of the original vector coordinates.
  These entries are continuous. Conversely, expand a coordinate vector in the
  fixed exterior basis. Lift its basis vectors through the original inverse
  chart and use its coefficients in one finite-wedge-sum generator. This is a
  continuous local lift, proving that the final topology is the chart topology.
  Stage 3: projection to X is continuous by the generating-domain test, so the
  preimage of the original open base set is open. The coordinate equivalence
  and its inverse therefore give the claimed trivialization and exact formula.
  Empty wedge products supply the scalar direction when r=0; the empty sum
  retains the base coordinate even at the zero section. No varying basis is
  chosen independently at individual points. -/
  classical
  -- The supplied chart has a Unit-tagged total space; retain its actual inverse fiber casts.
  let eLin (x : X) (hx : x ∈ e.baseSet) : E x ≃ₗ[ℂ] (Fin r → ℂ) :=
    { toFun := fun v ↦ (e ⟨x, v⟩).2
      invFun := fun v ↦ cast (congrArg E (e.proj_symm_apply' hx))
        (e.toOpenPartialHomeomorph.symm (x, v)).snd
      left_inv := by
        intro v
        rw [cast_eq_iff_heq]
        exact congr_arg_heq (fun z : TotalSpace Unit E ↦ z.snd)
          (e.symm_apply_mk_proj (x := ⟨x, v⟩) (e.mem_source.mpr hx))
      right_inv := by
        intro v
        have hp := TotalSpace.mk_cast (F := Unit) (E := E)
          (e.proj_symm_apply' (x := v) hx) (e.toOpenPartialHomeomorph.symm (x, v)).snd
        exact (congrArg (fun z : TotalSpace Unit E ↦ (e z).2) hp).trans
          (congrArg Prod.snd (e.apply_symm_apply' hx))
      map_add' := (he x hx).map_add
      map_smul' := (he x hx).map_smul }
  have hpoint (x : X) (hx : x ∈ e.baseSet) (v : Fin r → ℂ) :
      (⟨x, (eLin x hx).symm v⟩ : TotalSpace Unit E) =
        e.toOpenPartialHomeomorph.symm (x, v) :=
    TotalSpace.mk_cast (F := Unit) (E := E) (e.proj_symm_apply' hx) _
  let N := Fintype.card (Finset (Fin r))
  let C := Fin N → ℂ
  let b := (Pi.basisFun ℂ (Fin r)).ExteriorAlgebra.reindex
    (Fintype.equivFin (Finset (Fin r)))
  let c : ExteriorAlgebra ℂ (Fin r → ℂ) ≃ₗ[ℂ] C := b.equivFun
  let A := TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x))
  let D (m : ℕ) (k : Fin m → ℕ) := TotalSpace Unit
    (fun x ↦ (Fin m → ℂ) × (∀ i : Fin m, Fin (k i) → E x))
  let dtop (m : ℕ) (k : Fin m → ℕ) : TopologicalSpace (D m k) :=
    TopologicalSpace.induced (fun z : D m k ↦ (z.proj, z.snd.1,
      (fun (i : Fin m) (j : Fin (k i)) ↦
        (⟨z.proj, z.snd.2 i j⟩ : TotalSpace Unit E)))) inferInstance
  let G (m : ℕ) (k : Fin m → ℕ) (z : D m k) : A :=
    ⟨z.proj, ∑ i : Fin m, z.snd.1 i • ExteriorAlgebra.ιMulti ℂ (k i) (z.snd.2 i)⟩
  have hG (m : ℕ) (k : Fin m → ℕ) : @Continuous (D m k) A (dtop m k) exteriorTopology (G m k) :=
    continuous_iSup_rng (i := m) (continuous_iSup_rng (i := k) continuous_coinduced_rng)
  have hcoords (m : ℕ) (k : Fin m → ℕ) : @Continuous (D m k) _ (dtop m k) _
      (fun z : D m k ↦ (z.proj, z.snd.1,
        (fun (i : Fin m) (j : Fin (k i)) ↦
          (⟨z.proj, z.snd.2 i j⟩ : TotalSpace Unit E)))) := continuous_induced_dom
  have hbase : Continuous (π Unit (fun x ↦ ExteriorAlgebra ℂ (E x))) := by
    change @Continuous A X exteriorTopology _ _
    simp only [continuous_iSup_dom, continuous_coinduced_dom]
    intro m k
    exact (hcoords m k).fst
  -- Exterior functoriality supplies inverse linear maps on the original chart domain.
  let cLin (x : X) (hx : x ∈ e.baseSet) : ExteriorAlgebra ℂ (E x) ≃ₗ[ℂ] C :=
    { toLinearMap := c.toLinearMap.comp (ExteriorAlgebra.map (eLin x hx).toLinearMap).toLinearMap
      invFun := fun v ↦ ExteriorAlgebra.map (eLin x hx).symm.toLinearMap (c.symm v)
      left_inv := by
        intro a
        change ExteriorAlgebra.map (eLin x hx).symm.toLinearMap
          (c.symm (c (ExteriorAlgebra.map (eLin x hx).toLinearMap a))) = a
        rw [c.symm_apply_apply, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
        rw [LinearEquiv.symm_comp, ExteriorAlgebra.map_id]
        rfl
      right_inv := by
        intro v
        change c (ExteriorAlgebra.map (eLin x hx).toLinearMap
          (ExteriorAlgebra.map (eLin x hx).symm.toLinearMap (c.symm v))) = v
        rw [← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
        rw [LinearEquiv.comp_symm, ExteriorAlgebra.map_id]
        exact c.apply_symm_apply v }
  let F (z : A) : X × C :=
    (z.proj, if hx : z.proj ∈ e.baseSet then cLin z.proj hx z.snd else 0)
  let H (z : X × C) : A :=
    ⟨z.1, if hx : z.1 ∈ e.baseSet then (cLin z.1 hx).symm z.2 else 0⟩
  have hleft (z : A) (hz : z.proj ∈ e.baseSet) : H (F z) = z := by
    apply TotalSpace.ext
    · rfl
    apply heq_of_eq
    simp only [H, F, dite_eq_left hz, LinearEquiv.symm_apply_apply]
  have hright (z : X × C) (hz : z.1 ∈ e.baseSet) : F (H z) = z := by
    apply Prod.ext
    · rfl
    simp only [H, F, dite_eq_left hz, LinearEquiv.apply_symm_apply]
  -- Coordinate wedge monomials are polynomial maps in finitely many scalar coordinates.
  have hmulti (k : ℕ) : Continuous (fun a : Fin k → (Fin r → ℂ) ↦
      c (ExteriorAlgebra.ιMulti ℂ k a)) := by
    let T := c.toLinearMap.compMultilinearMap (ExteriorAlgebra.ιMulti ℂ k).toMultilinearMap
    have hexpand (a : Fin k → (Fin r → ℂ)) : T a =
        ∑ j : Fin k → Fin r, (∏ i : Fin k, a i (j i)) •
          T (fun i ↦ Pi.basisFun ℂ (Fin r) (j i)) := by
      have hb (i : Fin k) : a i = ∑ j : Fin r, a i j • Pi.basisFun ℂ (Fin r) j := by
        exact ((Pi.basisFun ℂ (Fin r)).sum_repr (a i)).symm
      conv_lhs => rw [show a = (fun i ↦ ∑ j : Fin r,
        a i j • Pi.basisFun ℂ (Fin r) j) from funext hb]
      rw [T.map_sum]
      apply Finset.sum_congr rfl
      intro j _
      exact T.map_smul_univ _ _
    have hc : Continuous (fun a : Fin k → (Fin r → ℂ) ↦
        ∑ j : Fin k → Fin r, (∏ i : Fin k, a i (j i)) •
          T (fun i ↦ Pi.basisFun ℂ (Fin r) (j i))) := by
      apply continuous_finsetSum
      intro j _
      have hp : Continuous (fun a : Fin k → (Fin r → ℂ) ↦ ∏ i : Fin k, a i (j i)) := by
        apply continuous_finsetProd
        intro i _
        exact (continuous_apply (j i)).comp (continuous_apply i)
      exact hp.smul (continuous_const (y := T (fun i ↦ Pi.basisFun ℂ (Fin r) (j i))))
    exact hc.congr (fun a ↦ (hexpand a).symm)
  have hforward : ContinuousOn F (π Unit (fun x ↦ ExteriorAlgebra ℂ (E x)) ⁻¹' e.baseSet) := by
    apply (continuousOn_open_iff (e.open_baseSet.preimage hbase)).mpr
    intro O hO
    change @IsOpen A exteriorTopology _
    simp only [isOpen_iSup_iff, isOpen_coinduced]
    intro m k
    let := dtop m k
    have hdata : Continuous (fun z : D m k ↦ (z.proj, z.snd.1,
        (fun (i : Fin m) (j : Fin (k i)) ↦
          (⟨z.proj, z.snd.2 i j⟩ : TotalSpace Unit E)))) := continuous_induced_dom
    let U : Set (D m k) := {z | z.proj ∈ e.baseSet}
    have hU : IsOpen U := e.open_baseSet.preimage hdata.fst
    have hc : ContinuousOn (F ∘ G m k) U := by
      rw [continuousOn_iff_continuous_domRestrict]
      have hv (i : Fin m) (j : Fin (k i)) : Continuous (fun z : U ↦
          (e ⟨z.val.proj, z.val.snd.2 i j⟩).2) := by
        apply Continuous.snd
        apply e.toOpenPartialHomeomorph.continuousOn.comp_continuous
        · exact ((continuous_apply j).comp ((continuous_apply i).comp hdata.snd.snd)).comp
            continuous_subtype_val
        · intro z
          exact e.mem_source.mpr z.property
      have hsum : Continuous (fun z : U ↦
          ∑ i : Fin m, z.val.snd.1 i •
            c (ExteriorAlgebra.ιMulti ℂ (k i)
              (fun j ↦ (e ⟨z.val.proj, z.val.snd.2 i j⟩).2))) := by
        apply continuous_finsetSum
        intro i _
        exact (((continuous_apply i).comp hdata.snd.fst).comp continuous_subtype_val).smul
          ((hmulti (k i)).comp (continuous_pi (hv i)))
      apply ((hdata.fst.comp continuous_subtype_val).prodMk hsum).congr
      intro z
      apply Prod.ext
      · rfl
      change _ = if hx : z.val.proj ∈ e.baseSet then cLin z.val.proj hx
        (∑ i : Fin m, z.val.snd.1 i • ExteriorAlgebra.ιMulti ℂ (k i) (z.val.snd.2 i)) else 0
      have hz : z.val.proj ∈ e.baseSet := z.property
      rw [dite_eq_left hz]
      change _ = c (ExteriorAlgebra.map (eLin z.val.proj z.property).toLinearMap
        (∑ i : Fin m, z.val.snd.1 i • ExteriorAlgebra.ιMulti ℂ (k i) (z.val.snd.2 i)))
      rw [map_sum, map_sum]
      dsimp only
      apply Finset.sum_congr rfl
      intro i _
      rw [map_smul, map_smul, ExteriorAlgebra.map_apply_ιMulti]
      rfl
    exact hc.isOpen_inter_preimage hU hO
  -- A fixed finite wedge expansion provides a continuous lift of the inverse chart.
  have hbasis (j : Fin N) : ∃ (k : ℕ) (v : Fin k → (Fin r → ℂ)),
      b j = ExteriorAlgebra.ιMulti ℂ k v := by
    simp only [b, Module.Basis.reindex_apply, ExteriorAlgebra.basis_apply]
    exact ⟨_, _, rfl⟩
  have hinverse : ContinuousOn H (e.baseSet ×ˢ Set.univ) := by
    choose k v hv using hbasis
    let U : Set (X × C) := e.baseSet ×ˢ Set.univ
    let lift (z : U) : D N k :=
      ⟨z.val.1, (z.val.2, fun j l ↦ (eLin z.val.1 z.property.1).symm (v j l))⟩
    let := dtop N k
    have hlift : Continuous lift := by
      apply continuous_induced_rng.mpr
      apply Continuous.prodMk (continuous_fst.comp continuous_subtype_val)
      apply Continuous.prodMk (continuous_snd.comp continuous_subtype_val)
      apply continuous_pi
      intro j
      apply continuous_pi
      intro l
      have hc : Continuous (fun z : U ↦
          e.toOpenPartialHomeomorph.symm (z.val.1, v j l)) :=
        e.toOpenPartialHomeomorph.continuousOn_symm.comp_continuous
        ((continuous_fst.comp continuous_subtype_val).prodMk continuous_const)
        (fun z : U ↦ e.mem_target.mpr z.property.1)
      exact hc.congr (fun z ↦ (hpoint z.val.1 z.property.1 (v j l)).symm)
    rw [continuousOn_iff_continuous_domRestrict]
    apply ((hG N k).comp hlift).congr
    intro z
    apply TotalSpace.ext
    · rfl
    apply heq_of_eq
    change (∑ j : Fin N, z.val.2 j •
      ExteriorAlgebra.ιMulti ℂ (k j) (fun l ↦ (eLin z.val.1 z.property.1).symm (v j l))) =
        if hx : z.val.1 ∈ e.baseSet then (cLin z.val.1 hx).symm z.val.2 else 0
    rw [dite_eq_left z.property.1]
    change _ = ExteriorAlgebra.map (eLin z.val.1 z.property.1).symm.toLinearMap
      (c.symm z.val.2)
    have hexpand : c.symm z.val.2 = ∑ j : Fin N, z.val.2 j • b j := by
      exact b.equivFun_symm_apply z.val.2
    rw [hexpand, map_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [map_smul, hv j, ExteriorAlgebra.map_apply_ιMulti]
    rfl
  let t : Trivialization C (π Unit (fun x ↦ ExteriorAlgebra ℂ (E x))) :=
    { toFun := F
      invFun := H
      source := π Unit (fun x ↦ ExteriorAlgebra ℂ (E x)) ⁻¹' e.baseSet
      target := e.baseSet ×ˢ Set.univ
      baseSet := e.baseSet
      open_source := e.open_baseSet.preimage hbase
      open_target := e.open_baseSet.prod isOpen_univ
      open_baseSet := e.open_baseSet
      map_source' := fun _ hz ↦ ⟨hz, Set.mem_univ _⟩
      map_target' := fun _ hz ↦ hz.1
      left_inv' := fun z hz ↦ hleft z hz
      right_inv' := fun z hz ↦ hright z hz.1
      source_eq := rfl
      target_eq := rfl
      proj_toFun := fun _ _ ↦ rfl
      continuousOn_toFun := hforward
      continuousOn_invFun := hinverse }
  refine ⟨t, rfl, ?_, ?_⟩
  · intro x hx
    have hv (a : ExteriorAlgebra ℂ (E x)) : (t ⟨x, a⟩).2 = cLin x hx a := by
      exact dite_eq_left hx
    constructor
    · intro a b
      rw [hv, hv, hv, map_add]
    · intro z a
      rw [hv, hv, map_smul]
  · intro x hx a
    change (if hx : x ∈ e.baseSet then cLin x hx a else 0) = _
    rw [dite_eq_left hx]
    rfl

/-- The exterior algebra of a locally finite-rank bundle is locally finite rank. -/
theorem isFiniteRank_exterior [IsFiniteRank E] :
    IsFiniteRank (fun x ↦ ExteriorAlgebra ℂ (E x)) := by
  /- At each base point choose one of the original finite linear charts.
  Its exterior trivialization has the same base set and finite coordinate rank
  2^r. The point lies in this base set, giving the local chart in IsFiniteRank.
  This is a local assertion and imposes no globally constant or bounded rank. -/
  constructor
  intro x
  obtain ⟨r, e, hx, he⟩ := IsFiniteRank.exists_linear_trivialization (E := E) x
  obtain ⟨t, ht, hlinear, _⟩ := exists_exterior_trivialization e he
  refine ⟨Fintype.card (Finset (Fin r)), t, ?_, hlinear⟩
  rw [ht]
  exact hx

/-- The standard even and odd exterior parts are locally finite-rank subbundles. -/
theorem isFiniteRank_exteriorParity [IsFiniteRank E] (i : ZMod 2) :
    IsFiniteRank (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i) := by
  /- Stage 1: take the exterior coordinates of an original finite linear chart.
  Exterior-algebra maps preserve degree and hence parity. The parity-i subspace
  therefore becomes the span of the fixed coordinate wedge monomials whose
  degrees have parity i, with the empty monomial in the even subspace.
  Stage 2: restrict the exterior chart to this fixed coordinate subspace.
  The induced topology on the original parity total space is exactly the
  subspace chart topology. Reindex the finitely many parity basis vectors by
  Fin of their cardinality to obtain the required finite linear trivialization.
  These charts cover the base. For r=0 the even and odd coordinate dimensions
  are respectively one and zero, so the construction never requires equal
  parity ranks, positive rank, a metric, or a compact base. -/
  classical
  constructor
  intro x₀
  obtain ⟨r, e, hx₀, he⟩ := IsFiniteRank.exists_linear_trivialization (E := E) x₀
  obtain ⟨t, ht, _, hformula⟩ := exists_exterior_trivialization e he
  -- The supplied chart has a Unit-tagged total space; retain its actual inverse fiber casts.
  let eLin (x : X) (hx : x ∈ e.baseSet) : E x ≃ₗ[ℂ] (Fin r → ℂ) :=
    { toFun := fun v ↦ (e ⟨x, v⟩).2
      invFun := fun v ↦ cast (congrArg E (e.proj_symm_apply' hx))
        (e.toOpenPartialHomeomorph.symm (x, v)).snd
      left_inv := by
        intro v
        rw [cast_eq_iff_heq]
        exact congr_arg_heq (fun z : TotalSpace Unit E ↦ z.snd)
          (e.symm_apply_mk_proj (x := ⟨x, v⟩) (e.mem_source.mpr hx))
      right_inv := by
        intro v
        have hp := TotalSpace.mk_cast (F := Unit) (E := E)
          (e.proj_symm_apply' (x := v) hx) (e.toOpenPartialHomeomorph.symm (x, v)).snd
        exact (congrArg (fun z : TotalSpace Unit E ↦ (e z).2) hp).trans
          (congrArg Prod.snd (e.apply_symm_apply' hx))
      map_add' := (he x hx).map_add
      map_smul' := (he x hx).map_smul }
  let N := Fintype.card (Finset (Fin r))
  let C := Fin N → ℂ
  let c : ExteriorAlgebra ℂ (Fin r → ℂ) ≃ₗ[ℂ] C :=
    ((Pi.basisFun ℂ (Fin r)).ExteriorAlgebra.reindex
      (Fintype.equivFin (Finset (Fin r)))).equivFun
  let cLin (x : X) (hx : x ∈ e.baseSet) : ExteriorAlgebra ℂ (E x) ≃ₗ[ℂ] C :=
    { toLinearMap := c.toLinearMap.comp (ExteriorAlgebra.map (eLin x hx).toLinearMap).toLinearMap
      invFun := fun v ↦ ExteriorAlgebra.map (eLin x hx).symm.toLinearMap (c.symm v)
      left_inv := by
        intro a
        change ExteriorAlgebra.map (eLin x hx).symm.toLinearMap
          (c.symm (c (ExteriorAlgebra.map (eLin x hx).toLinearMap a))) = a
        rw [c.symm_apply_apply, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
        rw [LinearEquiv.symm_comp, ExteriorAlgebra.map_id]
        rfl
      right_inv := by
        intro v
        change c (ExteriorAlgebra.map (eLin x hx).toLinearMap
          (ExteriorAlgebra.map (eLin x hx).symm.toLinearMap (c.symm v))) = v
        rw [← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
        rw [LinearEquiv.comp_symm, ExteriorAlgebra.map_id]
        exact c.apply_symm_apply v }
  -- The same exterior coordinate equivalence maps each actual parity subspace onto a fixed one.
  let P : Submodule ℂ C :=
    (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (Fin r → ℂ)) i).map c.toLinearMap
  have hsub (x : X) (hx : x ∈ e.baseSet) :
      (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i).map
        (cLin x hx).toLinearMap = P := by
    change (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i).map
      (c.toLinearMap.comp (ExteriorAlgebra.map (eLin x hx).toLinearMap).toLinearMap) = P
    rw [Submodule.map_comp]
    have hp : (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i).map
        (ExteriorAlgebra.map (eLin x hx).toLinearMap).toLinearMap =
          CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (Fin r → ℂ)) i := by
      simp only [CliffordAlgebra.evenOdd, Submodule.map_iSup, Submodule.map_pow,
        ExteriorAlgebra.ι_range_map_map, LinearEquiv.range, Submodule.map_top]
    rw [hp]
  let pLin (x : X) (hx : x ∈ e.baseSet) :
      CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i ≃ₗ[ℂ] P :=
    ((cLin x hx).submoduleMap _).trans (LinearEquiv.ofEq _ P (hsub x hx))
  have hpval (x : X) (hx : x ∈ e.baseSet)
      (a : CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i) :
      (pLin x hx a).val = cLin x hx a.val := rfl
  have htval (x : X) (hx : x ∈ e.baseSet)
      (a : CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i) :
      t (⟨x, a.val⟩ : TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x))) =
        (x, (pLin x hx a).val) := by
    apply Prod.ext
    · exact t.proj_toFun _ (t.mem_source.mpr (ht.symm ▸ hx))
    · exact hformula x hx a.val
  have hpoint (x : X) (hx : x ∈ e.baseSet) (a : P) :
      (⟨x, ((pLin x hx).symm a).val⟩ : TotalSpace Unit
        (fun x ↦ ExteriorAlgebra ℂ (E x))) = t.toOpenPartialHomeomorph.symm (x, a.val) := by
    have h := t.symm_apply_mk_proj
      (x := (⟨x, ((pLin x hx).symm a).val⟩ : TotalSpace Unit
        (fun x ↦ ExteriorAlgebra ℂ (E x)))) (t.mem_source.mpr (ht.symm ▸ hx))
    rw [htval x hx, (pLin x hx).apply_symm_apply] at h
    exact h.symm
  let A := TotalSpace Unit (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i)
  let inc (z : A) : TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x)) :=
    ⟨z.proj, z.snd.val⟩
  have hinc : Continuous inc := continuous_induced_dom
  let := isFiniteRank_exterior (E := E)
  have hbase : Continuous (fun z : A ↦ z.proj) :=
    (continuous_proj (E := fun x ↦ ExteriorAlgebra ℂ (E x))).comp hinc
  let F (z : A) : X × P :=
    (z.proj, if hx : z.proj ∈ e.baseSet then pLin z.proj hx z.snd else 0)
  let H (z : X × P) : A :=
    ⟨z.1, if hx : z.1 ∈ e.baseSet then (pLin z.1 hx).symm z.2 else 0⟩
  have hleft (z : A) (hz : z.proj ∈ e.baseSet) : H (F z) = z := by
    apply TotalSpace.ext
    · rfl
    apply heq_of_eq
    simp only [H, F, dite_eq_left hz, LinearEquiv.symm_apply_apply]
  have hright (z : X × P) (hz : z.1 ∈ e.baseSet) : F (H z) = z := by
    apply Prod.ext
    · rfl
    simp only [H, F, dite_eq_left hz, LinearEquiv.apply_symm_apply]
  -- Restriction of the original exterior chart uses precisely the induced parity topology.
  have hforward : ContinuousOn F {z : A | z.proj ∈ e.baseSet} := by
    rw [continuousOn_iff_continuous_domRestrict]
    let U : Set A := {z | z.proj ∈ e.baseSet}
    have hc : Continuous (fun z : U ↦ t (inc z.val)) :=
      t.toOpenPartialHomeomorph.continuousOn.comp_continuous
        (hinc.comp continuous_subtype_val)
        (fun z ↦ t.mem_source.mpr (ht.symm ▸ z.property))
    apply Continuous.prodMk (hbase.comp continuous_subtype_val)
    apply continuous_induced_rng.mpr
    apply hc.snd.congr
    intro z
    change (t (inc z.val)).2 =
      (if hx : z.val.proj ∈ e.baseSet then pLin z.val.proj hx z.val.snd else 0).val
    have hz : z.val.proj ∈ e.baseSet := z.property
    rw [dite_eq_left hz]
    exact congrArg Prod.snd (htval z.val.proj hz z.val.snd)
  have hinverse : ContinuousOn H (e.baseSet ×ˢ Set.univ) := by
    rw [continuousOn_iff_continuous_domRestrict]
    let U : Set (X × P) := e.baseSet ×ˢ Set.univ
    apply continuous_induced_rng.mpr
    have hc : Continuous (fun z : U ↦ t.toOpenPartialHomeomorph.symm (z.val.1, z.val.2.val)) :=
      t.toOpenPartialHomeomorph.continuousOn_symm.comp_continuous
        ((continuous_fst.comp continuous_subtype_val).prodMk
          (continuous_subtype_val.comp (continuous_snd.comp continuous_subtype_val)))
        (fun z ↦ t.mem_target.mpr (ht.symm ▸ z.property.1))
    apply hc.congr
    intro z
    change t.toOpenPartialHomeomorph.symm (z.val.1, z.val.2.val) =
      (⟨z.val.1, (if hx : z.val.1 ∈ e.baseSet then
        (pLin z.val.1 hx).symm z.val.2 else 0).val⟩ : TotalSpace Unit
          (fun x ↦ ExteriorAlgebra ℂ (E x)))
    rw [dite_eq_left z.property.1]
    exact (hpoint z.val.1 z.property.1 z.val.2).symm
  let u : Trivialization P (π Unit
      (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i)) :=
    { toFun := F
      invFun := H
      source := {z : A | z.proj ∈ e.baseSet}
      target := e.baseSet ×ˢ Set.univ
      baseSet := e.baseSet
      open_source := e.open_baseSet.preimage hbase
      open_target := e.open_baseSet.prod isOpen_univ
      open_baseSet := e.open_baseSet
      map_source' := fun _ hz ↦ ⟨hz, Set.mem_univ _⟩
      map_target' := fun _ hz ↦ hz.1
      left_inv' := fun z hz ↦ hleft z hz
      right_inv' := fun z hz ↦ hright z hz.1
      source_eq := rfl
      target_eq := rfl
      proj_toFun := fun _ _ ↦ rfl
      continuousOn_toFun := hforward
      continuousOn_invFun := hinverse }
  -- Any finite basis of the fixed model subspace gives the required finite coordinate rank.
  let q : P ≃L[ℂ] (Fin (Module.finrank ℂ P) → ℂ) :=
    (Module.finBasis ℂ P).equivFun.toContinuousLinearEquiv
  refine ⟨Module.finrank ℂ P, u.transFiberHomeomorph q.toHomeomorph, hx₀, ?_⟩
  intro x hx
  change x ∈ e.baseSet at hx
  have hv (a : CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i) :
      ((u.transFiberHomeomorph q.toHomeomorph) ⟨x, a⟩).2 = q (pLin x hx a) := by
    change q (if hx : x ∈ e.baseSet then pLin x hx a else 0) = _
    rw [dite_eq_left hx]
  constructor
  · intro a b
    rw [hv, hv, hv, map_add, map_add]
  · intro z a
    rw [hv, hv, map_smul, map_smul]

end AtiyahSinger.ComplexBundle
