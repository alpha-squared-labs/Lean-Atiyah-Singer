module

public import AtiyahSinger.Algebra.ExteriorTopology
public import AtiyahSinger.Topology.ExteriorBundle
public import AtiyahSinger.Topology.ModelBundleTopology

/-!
# Exterior powers of a continuous family of linear maps

Public module ID: M1841.

A continuous family from one fixed finite-dimensional complex vector space
into a varying bundle induces a continuous family on its whole exterior algebra.
The target uses the original topology generated by finite wedge sums. The source
uses the original finite-dimensional norm topology. This comparison is used for
the actual varying sphere tangent coordinates and their exterior parity maps.
-/

@[expose] public noncomputable section

namespace AtiyahSinger.ComplexBundle

open Bundle

attribute [local instance] exteriorAlgebraNormedAddCommGroup exteriorAlgebraNormedSpace
  exteriorTopology exteriorParityTopology isFiniteRank_exteriorParity isFiniteRank_model
  isFiniteRank_pullback

variable {X Y V : Type*} [TopologicalSpace X] [TopologicalSpace Y]
  [NormedAddCommGroup V] [NormedSpace ℂ V] [FiniteDimensional ℂ V]
  {E : X → Type*} [∀ x, AddCommGroup (E x)] [∀ x, Module ℂ (E x)]
  [TopologicalSpace (TotalSpace Unit E)]

set_option maxHeartbeats 500000 in
-- One finite exterior basis gives one generator of the original wedge-sum topology.
/-- A continuous finite-dimensional family induces a continuous map of exterior total spaces. -/
theorem continuous_exteriorMap_family (f : C(Y, X)) (e : ∀ y, V →ₗ[ℂ] E (f y))
    (he : Continuous (fun p : Y × V ↦ (⟨f p.1, e p.1 p.2⟩ : TotalSpace Unit E))) :
    Continuous (fun p : Y × ExteriorAlgebra ℂ V ↦
      (⟨f p.1, ExteriorAlgebra.map (e p.1) p.2⟩ :
        TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x)))) := by
  classical
  let r := Module.finrank ℂ V
  let b : Module.Basis (Fin r) ℂ V := Module.finBasis ℂ V
  let m := Fintype.card (Finset (Fin r))
  let σ : Finset (Fin r) ≃ Fin m := Fintype.equivFin _
  let B : Module.Basis (Fin m) ℂ (ExteriorAlgebra ℂ V) := b.ExteriorAlgebra.reindex σ
  let s (j : Fin m) : Finset (Fin r) := σ.symm j
  let k (j : Fin m) : ℕ := (s j).card
  let v (j : Fin m) : Fin (k j) → V :=
    b ∘ (Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm (s j)).2)
  have hB (j : Fin m) : B j = ExteriorAlgebra.ιMulti ℂ (k j) (v j) := by
    rw [Module.Basis.reindex_apply, ExteriorAlgebra.basis_apply]
    rfl
  let D := TotalSpace Unit
    (fun x ↦ (Fin m → ℂ) × (∀ j : Fin m, Fin (k j) → E x))
  let : TopologicalSpace D := TopologicalSpace.induced
    (fun z : D ↦ (z.proj, z.snd.1,
      fun (j : Fin m) (l : Fin (k j)) ↦
        (⟨z.proj, z.snd.2 j l⟩ : TotalSpace Unit E))) inferInstance
  let q (p : Y × ExteriorAlgebra ℂ V) : D :=
    ⟨f p.1, B.equivFun p.2, fun j l ↦ e p.1 (v j l)⟩
  have hq : Continuous q := by
    apply continuous_induced_rng.mpr
    refine (f.continuous.comp continuous_fst).prodMk
      ((B.equivFun.continuous_of_finiteDimensional.comp continuous_snd).prodMk ?_)
    apply continuous_pi
    intro j
    apply continuous_pi
    intro l
    exact he.comp (continuous_fst.prodMk continuous_const)
  have hw : Continuous (fun z : D ↦
      (⟨z.proj, ∑ j : Fin m, z.snd.1 j •
        ExteriorAlgebra.ιMulti ℂ (k j) (z.snd.2 j)⟩ :
          TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x)))) :=
    continuous_iSup_rng (i := m) (continuous_iSup_rng (i := k) continuous_coinduced_rng)
  -- The generator is exactly the image of the exterior-basis expansion of the given vector.
  apply (hw.comp hq).congr
  intro p
  apply congrArg (fun w : ExteriorAlgebra ℂ (E (f p.1)) ↦
    (⟨f p.1, w⟩ : TotalSpace Unit (fun x ↦ ExteriorAlgebra ℂ (E x))))
  change (∑ j : Fin m, B.equivFun p.2 j •
    ExteriorAlgebra.ιMulti ℂ (k j) (fun l ↦ e p.1 (v j l))) = _
  have hsum := congrArg (ExteriorAlgebra.map (e p.1)) (B.sum_repr p.2)
  rw [map_sum] at hsum
  simpa only [map_smul, hB, ExteriorAlgebra.map_apply_ιMulti,
    Module.Basis.equivFun_apply, Function.comp_def] using hsum

private theorem exteriorMap_mem_evenOdd {A B : Type*} [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B] (l : A →ₗ[ℂ] B) (i : ZMod 2)
    (a : CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ A) i) :
    ExteriorAlgebra.map l a.val ∈ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ B) i := by
  let F := ExteriorAlgebra.map l
  have hrange : (LinearMap.range (CliffordAlgebra.ι (0 : QuadraticForm ℂ A))).map
      F.toLinearMap ≤ LinearMap.range (CliffordAlgebra.ι (0 : QuadraticForm ℂ B)) := by
    rintro _ ⟨x, ⟨v, rfl⟩, rfl⟩
    exact ⟨l v, (ExteriorAlgebra.map_apply_ι l v).symm⟩
  have hp : (CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ A) i).map F.toLinearMap ≤
      CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ B) i := by
    simp only [CliffordAlgebra.evenOdd, Submodule.map_iSup, Submodule.map_pow]
    exact iSup_mono (fun n ↦ pow_le_pow_left' hrange n.val)
  exact (Submodule.map_le_iff_le_comap.mp hp) a.property

set_option maxHeartbeats 700000 in
-- The algebraic parity inverse and the continuous finite-rank bundle inverse agree.
/-- A continuous family of linear frames gives the original exterior parity bundle frames. -/
theorem exists_exteriorParity_family_iso [IsFiniteRank E]
    (f : C(Y, X)) (e : ∀ y, V →ₗ[ℂ] E (f y)) (hebij : ∀ y, Function.Bijective (e y))
    (he : Continuous (fun p : Y × V ↦ (⟨f p.1, e p.1 p.2⟩ : TotalSpace Unit E)))
    (i : ZMod 2) :
    let P := CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ V) i
    letI := modelTopology P (Bundle.Trivial Y P)
    ∃ d : Iso (Bundle.Trivial Y P)
      ((f : Y → X) *ᵖ (fun x ↦ CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i)),
      ∀ (y : Y) (w : P), (d.linearEquiv y w).val = ExteriorAlgebra.map (e y) w.val := by
  classical
  let P := CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ V) i
  let Q (x : X) : Type _ := CliffordAlgebra.evenOdd (0 : QuadraticForm ℂ (E x)) i
  let := modelTopology P (Bundle.Trivial Y P)
  -- Exterior maps preserve the same degree parity for any complex linear map.
  let c (y : Y) : V ≃ₗ[ℂ] E (f y) := LinearEquiv.ofBijective (e y) (hebij y)
  let l (y : Y) : P ≃ₗ[ℂ] Q (f y) :=
    { toFun w := ⟨ExteriorAlgebra.map (e y) w.val, exteriorMap_mem_evenOdd (e y) i w⟩
      invFun w := ⟨ExteriorAlgebra.map (c y).symm.toLinearMap w.val,
        exteriorMap_mem_evenOdd (c y).symm.toLinearMap i w⟩
      left_inv w := by
        -- The original vector inverse lifts to the same exterior-algebra maps.
        apply Subtype.ext
        exact ((ExteriorAlgebra.leftInverse_map_iff
          (f := e y) (g := (c y).symm.toLinearMap)).mpr
            (fun v ↦ (c y).symm_apply_apply v)) w.val
      right_inv w := by
        apply Subtype.ext
        exact ((ExteriorAlgebra.leftInverse_map_iff
          (f := (c y).symm.toLinearMap) (g := e y)).mpr
            (fun v ↦ (c y).apply_symm_apply v)) w.val
      map_add' a b := Subtype.ext (map_add (ExteriorAlgebra.map (e y)) a.val b.val)
      map_smul' a w := Subtype.ext (map_smul (ExteriorAlgebra.map (e y)) a w.val) }
  -- The original normed model and the original induced parity topology retain the same vectors.
  let hP : TotalSpace Unit (Bundle.Trivial Y P) ≃ₜ Y × P :=
    (unitTotalHomeomorph P (Bundle.Trivial Y P)).trans (Bundle.Trivial.homeomorphProd Y P)
  let L : Hom (Bundle.Trivial Y P) ((f : Y → X) *ᵖ Q) :=
    { linearMap y := (l y).toLinearMap
      continuous_total := by
        rw [(inducing_pullbackTotalSpaceEmbedding Unit Q f).continuous_iff]
        refine hP.continuous.fst.prodMk ?_
        apply continuous_induced_rng.mpr
        exact (continuous_exteriorMap_family f e he).comp
          (hP.continuous.fst.prodMk (continuous_subtype_val.comp hP.continuous.snd)) }
  exact ⟨L.toIso (fun y ↦ (l y).bijective), fun _ _ ↦ rfl⟩

end AtiyahSinger.ComplexBundle
