module

public import Mathlib.AlgebraicTopology.SimplicialSet.Finite
public import Mathlib.AlgebraicTopology.SimplicialSet.NonDegenerateSimplicesColimit
public import Mathlib.AlgebraicTopology.SimplicialSet.TopAdj
public import Mathlib.Geometry.Convex.ConvexSpace.CompactSpaceStdSimplex
public import Mathlib.Topology.Category.TopCat.EpiMono

/-!
# Compactness of finite simplicial realizations

Public module ID: M1856.

The original geometric realization `SSet.toTop` of a finite simplicial set is
compact. Every monogenous subcomplex is covered by a standard simplex, and the
finitely many nondegenerate simplices give a finite cover of the realization.

This proves compactness for mathlib's existing realization, without introducing
a different quotient or asking for a compactness witness. Hausdorffness requires
the separate boundary and closed-attachment arguments.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Convexity

open scoped Simplicial

universe u

namespace SSet

/-- The geometric realization of a finite simplicial set is compact. -/
theorem compactSpace_toTop_of_finite (X : SSet.{u}) [X.Finite] : CompactSpace |X| := by
  -- The monogenous subcomplex generated by any nondegenerate simplex is the
  -- continuous image of the corresponding compact standard simplex.
  have hcompact (x : X.N) : CompactSpace |x.subcomplex| := by
    let : CompactSpace |(Δ[x.dim] : SSet.{u})| :=
      (SimplexCategory.toTopHomeo ⦋x.dim⦌).symm.compactSpace
    let q := SSet.toTop.map (Subcomplex.toOfSimplex x.simplex)
    have hq : Function.Surjective q := TopCat.epi_iff_surjective q |>.mp inferInstance
    exact hq.compactSpace q.hom.continuous
  let : ∀ x : X.N, CompactSpace |x.subcomplex| := hcompact
  -- Realization and the forgetful functor preserve the colimit by monogenous
  -- subcomplexes. Thus its structure maps jointly cover the realized space.
  let p : (Σ x : X.N, |x.subcomplex|) → |X| :=
    fun z ↦ SSet.toTop.map z.1.subcomplex.ι z.2
  have hp : Continuous p := by
    exact continuous_sigma fun x ↦ (SSet.toTop.map x.subcomplex.ι).hom.continuous
  have hsurj : Function.Surjective p := by
    intro z
    obtain ⟨x, y, hxy⟩ := Types.jointly_surjective_of_isColimit
      (isColimitOfPreserves (SSet.toTop ⋙ forget TopCat) (X.isColimitCoconeN)) z
    exact ⟨⟨x, y⟩, hxy⟩
  -- There are finitely many nondegenerate simplices, so the covering disjoint
  -- union is compact. Compactness descends through its continuous surjection.
  exact hsurj.compactSpace hp

end SSet
