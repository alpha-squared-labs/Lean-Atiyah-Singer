module

public import AtiyahSinger.Topology.KZero
public import AtiyahSinger.Topology.RightKZero

/-!
# The same-matrix comparison with the existing commutative K₀

Public module ID: M2110.

For a commutative ring the right-projective presentation and the existing
commutative presentation have the same finite matrices, the same rectangular
witnesses and the same block sums. The two actual quotient homomorphisms below
are induced by that correspondence. Their inverse laws give the displayed
additive equivalence; no arbitrary isomorphism of abstract groups is selected.

This comparison preserves p itself, rather than its transpose or an opposite
matrix. It makes no identification of independently supplied left and right
module structures on an arbitrary P. Such a module-level comparison requires
explicit scalar restriction or a compatibility equation and is not used here.

Sources: Karoubi, K-Theory, I.6.16 and III.1.5, 1.9--1.10, for the finite-projective
Grothendieck presentation; II.3.10 specifies the right-module convention.
For commutative coefficients the right/left
conventions agree through the canonical ring isomorphism with the opposite
ring. The quotient-level construction below records that standard comparison
on the exact idempotent generators used by both existing models.
-/

@[expose] public noncomputable section

namespace AtiyahSinger.RightKTheory

universe u

variable (R : Type u) [CommRing R]

namespace IdempotentMatrix

variable {R}

/-- The same finite matrix regarded as an existing commutative presentation. -/
def toComm (p : IdempotentMatrix R) : AtiyahSinger.IdempotentMatrix R where
  size := p.size
  matrix := p.matrix
  mul_self := p.mul_self

/-- The literal same-matrix equivalence between the two presentation types. -/
def commEquiv (R : Type u) [CommRing R] :
    IdempotentMatrix R ≃ AtiyahSinger.IdempotentMatrix R where
  toFun := toComm
  invFun p := ⟨p.size, p.matrix, p.mul_self⟩
  left_inv p := by
    cases p
    rfl
  right_inv p := by
    cases p
    rfl

end IdempotentMatrix

/-- The same-matrix generator maps kill the defining relations in both directions:
each sends the isomorphism and direct-sum differences to zero. -/
theorem commKZero_relations :
    kZeroRelations R ≤
        (FreeAbelianGroup.lift (fun p : IdempotentMatrix R ↦
          AtiyahSinger.kZeroClass R p.toComm)).ker ∧
      AtiyahSinger.kZeroRelations R ≤
        (FreeAbelianGroup.lift (fun p : AtiyahSinger.IdempotentMatrix R ↦
          kZeroClass R ((IdempotentMatrix.commEquiv R).symm p))).ker := by
  /- Stage 1: both presentation maps retain the original size and matrix.
  Therefore the same rectangular a and b satisfy the same four equations
  before and after conversion. Their image-class differences vanish in
  the target quotient.
  Stage 2: conversion also retains the exact reindexed block matrix.
  The block-sum differences vanish in each target. Each kernel is an
  additive subgroup, so it contains the subgroup generated by these
  two families of relations. This verifies both directions at once. -/
  -- The same rectangular witnesses survive both literal matrix conversions.
  have hforward (p q : IdempotentMatrix R) (h : p.IsEquivalent q) :
      AtiyahSinger.kZeroClass R p.toComm = AtiyahSinger.kZeroClass R q.toComm :=
    AtiyahSinger.kZeroClass_eq_of_isEquivalent p.toComm q.toComm h
  have hbackward (p q : AtiyahSinger.IdempotentMatrix R) (h : p.IsEquivalent q) :
      kZeroClass R ((IdempotentMatrix.commEquiv R).symm p) =
        kZeroClass R ((IdempotentMatrix.commEquiv R).symm q) :=
    kZeroClass_eq_of_isEquivalent _ _ h
  -- Kill both generating families before passing to the generated subgroup.
  constructor
  · apply (AddSubgroup.closure_le _).mpr
    rintro x (⟨p, q, hpq, rfl⟩ | ⟨p, q, rfl⟩)
    · change (FreeAbelianGroup.lift _) (_ - _) = 0
      simp [hforward p q hpq]
    · change (FreeAbelianGroup.lift _) (_ - _ - _) = 0
      have hblock : (p.blockSum q).toComm = p.toComm.blockSum q.toComm := rfl
      simp [hblock, AtiyahSinger.kZeroClass_blockSum]
  · apply (AddSubgroup.closure_le _).mpr
    rintro x (⟨p, q, hpq, rfl⟩ | ⟨p, q, rfl⟩)
    · change (FreeAbelianGroup.lift _) (_ - _) = 0
      simp [hbackward p q hpq]
    · change (FreeAbelianGroup.lift _) (_ - _ - _) = 0
      have hblock : (IdempotentMatrix.commEquiv R).symm (p.blockSum q) =
          ((IdempotentMatrix.commEquiv R).symm p).blockSum
            ((IdempotentMatrix.commEquiv R).symm q) := rfl
      simp [hblock, kZeroClass_blockSum]

/-- The quotient homomorphism sending every right presentation to its same commutative matrix. -/
def toCommKZero : KZero R →+ AtiyahSinger.KZero R :=
  QuotientAddGroup.lift (kZeroRelations R)
    (FreeAbelianGroup.lift (fun p : IdempotentMatrix R ↦
      AtiyahSinger.kZeroClass R p.toComm))
    (fun _ hx ↦ (commKZero_relations R).1 hx)

/-- The quotient homomorphism retaining each commutative matrix as a right presentation. -/
def fromCommKZero : AtiyahSinger.KZero R →+ KZero R :=
  QuotientAddGroup.lift (AtiyahSinger.kZeroRelations R)
    (FreeAbelianGroup.lift (fun p : AtiyahSinger.IdempotentMatrix R ↦
      kZeroClass R ((IdempotentMatrix.commEquiv R).symm p)))
    (fun _ hx ↦ (commKZero_relations R).2 hx)

/-- The two specified quotient maps are inverse on the original K₀ carriers. -/
theorem commKZero_inverse :
    (fromCommKZero R).comp (toCommKZero R) = AddMonoidHom.id (KZero R) ∧
      (toCommKZero R).comp (fromCommKZero R) = AddMonoidHom.id (AtiyahSinger.KZero R) := by
  /- Evaluate each composite on an original idempotent generator. The
  two same-matrix conversions cancel by commEquiv, so the composite fixes
  that generator. The quotient images of the free generators generate
  each group. Additive homomorphism extensionality therefore gives the
  two displayed identities on all virtual projective classes. -/
  -- First compare the composites on the same finite idempotent generators.
  constructor
  · apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro p
    change fromCommKZero R (toCommKZero R (kZeroClass R p)) = kZeroClass R p
    simp [toCommKZero, fromCommKZero, kZeroClass, AtiyahSinger.kZeroClass,
      IdempotentMatrix.commEquiv, IdempotentMatrix.toComm]
  · apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro p
    change toCommKZero R (fromCommKZero R (AtiyahSinger.kZeroClass R p)) =
      AtiyahSinger.kZeroClass R p
    simp [toCommKZero, fromCommKZero, kZeroClass, AtiyahSinger.kZeroClass,
      IdempotentMatrix.commEquiv, IdempotentMatrix.toComm]

/-- The additive equivalence defined by the two actual same-matrix quotient maps. -/
def commKZeroEquiv : KZero R ≃+ AtiyahSinger.KZero R where
  toFun := toCommKZero R
  invFun := fromCommKZero R
  left_inv x := DFunLike.congr_fun (commKZero_inverse R).1 x
  right_inv x := DFunLike.congr_fun (commKZero_inverse R).2 x
  map_add' := map_add (toCommKZero R)

/-- The comparison sends each specified right generator to that matrix's commutative class. -/
theorem commKZeroEquiv_class (p : IdempotentMatrix R) :
    commKZeroEquiv R (kZeroClass R p) = AtiyahSinger.kZeroClass R p.toComm := by
  /- The forward map is toCommKZero. Evaluate its quotient lift and then
  its free abelian lift on the generator p. The result is precisely the
  commutative class of p.toComm, whose matrix and size are those of p itself. -/
  -- Evaluate the actual quotient lift; no abstract group equivalence is chosen.
  exact FreeAbelianGroup.lift_apply_of
    (fun q : IdempotentMatrix R ↦ AtiyahSinger.kZeroClass R q.toComm) p

end AtiyahSinger.RightKTheory
